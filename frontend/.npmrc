# Belt-and-suspenders: the canonical pnpm 10 location for onlyBuiltDependencies
# is pnpm-workspace.yaml, but mirroring the allowlist here ensures the
# packages can run their install scripts even if pnpm reads .npmrc first
# or the workspace yaml is skipped for any reason.
only-built-dependencies[]=@prisma/client
only-built-dependencies[]=@prisma/engines
only-built-dependencies[]=esbuild
only-built-dependencies[]=prisma
only-built-dependencies[]=protobufjs
only-built-dependencies[]=sharp
only-built-dependencies[]=unrs-resolver
