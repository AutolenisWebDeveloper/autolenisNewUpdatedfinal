// Admin audit log — records every admin action with actor, timestamp, reason
// Logged by all admin action API routes per C.5 requirement
model AdminAuditLog {
  id             String   @id @default(uuid())
  adminId        String   @map("admin_id")
  adminEmail     String   @map("admin_email")
  action         String   // e.g. "DEAL_STAGE_ADVANCED", "AUCTION_CLOSED", "REFUND_TRIGGERED"
  entityType     String   @map("entity_type") // "Deal" | "Auction" | "Buyer" | "Offer"
  entityId       String   @map("entity_id")
  reason         String?
  metadata       Json?
  previousState  Json?    @map("previous_state")
  newState       Json?    @map("new_state")
  ipAddress      String?  @map("ip_address")
  sessionId      String?  @map("session_id")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([adminId])
  @@map("admin_audit_logs")
}

