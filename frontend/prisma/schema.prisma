generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id         String     @id @default(uuid())
  supabaseId String     @unique @map("supabase_id")
  email      String     @unique
  role       UserRole
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")
  admin      Admin?
  affiliate  Affiliate?
  buyer      Buyer?
  dealer     Dealer?
  sessions   Session[]
  acceptedTerms AcceptedTerms[]
  requiresPasswordChange Boolean @default(false) @map("requires_password_change")

  @@map("users")
}

model Buyer {
  id                 String               @id @default(uuid())
  userId             String               @unique @map("user_id")
  firstName          String               @map("first_name")
  lastName           String               @map("last_name")
  phone              String?
  address            String?
  city               String?
  state              String?
  zip                String?
  onboardingComplete Boolean              @default(false) @map("onboarding_complete")
  termsAcceptedAt    DateTime?            @map("terms_accepted_at")
  termsVersion       String?              @map("terms_version")
  profilePictureUrl  String?              @map("profile_picture_url")
  employmentStatus   String?              @map("employment_status")
  incomeRange        String?              @map("income_range")
  affiliateId        String?              @map("affiliate_id")
  plan               BuyerPlan            @default(STANDARD)
  planUpgradedAt     DateTime?            @map("plan_upgraded_at")
  // Lifecycle management — set by admin actions
  archivedAt         DateTime?            @map("archived_at")
  disabledAt         DateTime?            @map("disabled_at")
  purgedAt           DateTime?            @map("purged_at")
  // Suspension — set by admin suspend/unsuspend actions
  isSuspended        Boolean              @default(false) @map("is_suspended")
  suspendedAt        DateTime?            @map("suspended_at")
  suspendedReason    String?              @map("suspended_reason")
  isGuest            Boolean              @default(false) @map("is_guest")
  // AI acquisition fields — populated by the conversational finder + lead scorer
  leadScore          Int?                 @map("lead_score")
  leadTemperature    String?              @map("lead_temperature")
  sequencePaused     Boolean              @default(false) @map("sequence_paused")
  optedOutSms        Boolean              @default(false) @map("opted_out_sms")
  timezone           String?
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")
  auctions           Auction[]
  activityEvents     BuyerActivityEvent[]
  user               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  deals              Deal[]
  deposits           Deposit[]
  notifications      Notification[]
  nudgeEvents        NudgeEvent[]
  preQualification   PreQualification?
  savedSearches      SavedSearch[]
  shortlists         Shortlist?
  vehicleRequests       VehicleRequest[]
  externalPreApprovals  ExternalPreApproval[]
  creditApplications    CreditApplication[] // Phase 5 — lender decisioning applications
  tradeInSubmissions    TradeInSubmission[]
  financingScenarios    FinancingScenario[]
  insuranceQuotes       InsuranceQuote[]
  insurancePolicies     InsurancePolicy[]
  refinanceApplications RefinanceApplication[]
  preferences           BuyerPreferences?
  complianceEvents      ComplianceEvent[]
  adminJourneyUnlocks   AdminJourneyUnlock[]
  adminJourneyNotes     AdminJourneyNote[]
  conversations         Conversation[]
  buyerOpportunities    BuyerOpportunity[]

  @@map("buyers")
}

model AdminJourneyUnlock {
  id          String                    @id @default(cuid())
  buyerId     String                    @map("buyer_id")
  stageId     String                    @map("stage_id")
  type        AdminJourneyOverrideType  @default(UNLOCK) @map("type")
  adminId     String                    @map("admin_id")
  adminEmail  String                    @map("admin_email")
  note        String?
  createdAt   DateTime                  @default(now()) @map("created_at")

  buyer Buyer @relation(fields: [buyerId], references: [id], onDelete: Cascade)

  @@unique([buyerId, stageId])
  @@index([buyerId])
  @@map("admin_journey_unlocks")
}

model AdminJourneyNote {
  id         String   @id @default(cuid())
  buyerId    String   @map("buyer_id")
  stageId    String   @map("stage_id")
  content    String
  adminId    String   @map("admin_id")
  adminEmail String   @map("admin_email")
  createdAt  DateTime @default(now()) @map("created_at")

  buyer Buyer @relation(fields: [buyerId], references: [id], onDelete: Cascade)

  @@index([buyerId, stageId])
  @@map("admin_journey_notes")
}

model BuyerPreferences {
  id                   String   @id @default(uuid())
  buyerId              String   @unique @map("buyer_id")
  emailNotifications   Boolean  @default(true) @map("email_notifications")
  smsNotifications     Boolean  @default(false) @map("sms_notifications")
  marketingEmails      Boolean  @default(false) @map("marketing_emails")
  auctionAlerts        Boolean  @default(true) @map("auction_alerts")
  dealUpdates          Boolean  @default(true) @map("deal_updates")
  vehicleTypePreference String? @map("vehicle_type_preference")
  newOrUsedPreference   String? @map("new_or_used_preference")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")
  buyer                Buyer    @relation(fields: [buyerId], references: [id], onDelete: Cascade)

  @@map("buyer_preferences")
}

model Dealer {
  id                 String                    @id @default(uuid())
  userId             String                    @unique @map("user_id")
  dealershipName     String                    @map("dealership_name")
  phone              String?
  address            String?
  city               String?
  state              String?
  zip                String?
  // Y5 — geocoded coordinates (from ZIP via the geocoding adapter). Nullable +
  // backfilled; used by the unified-sourcing geo filter instead of static ZIP maps.
  latitude           Float?                    @map("latitude")
  longitude          Float?                    @map("longitude")
  // A2 — resolved canonical rooftop (cross-pool dedup). Nullable; a Dealer maps
  // to at most one physical rooftop. SetNull so deleting a rooftop never cascades.
  rooftopId          String?                   @map("rooftop_id")
  rooftop            DealerRooftop?            @relation(fields: [rooftopId], references: [id], onDelete: SetNull)
  status             DealerStatus              @default(PENDING)
  tier               String                    @default("STANDARD")
  // System placeholder used to satisfy Offer.dealerId for outside /
  // unregistered dealers. Never a real, operating dealer — excluded from
  // dealer-facing matching and public stats.
  isSystemPlaceholder Boolean                  @default(false) @map("is_system_placeholder")
  currentAuctionLoad Int                       @default(0) @map("current_auction_load")
  scorecardTier      String?                   @map("scorecard_tier")
  createdAt          DateTime                  @default(now()) @map("created_at")
  updatedAt          DateTime                  @updatedAt @map("updated_at")
  scorecardSnapshots DealerScorecardSnapshot[]
  user               User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  inventory          InventoryItem[]
  notifications      Notification[]
  offers             Offer[]
  conciergeSubmissions DealerOfferSubmission[]
  invitations        AuctionInvitation[]       @relation("DealerInvitations")
  feedConfig         DealerFeedConfig?         @relation("DealerFeedConfig")
  licenseNumber      String?                   @map("license_number")
  agreedToTermsAt    DateTime?                 @map("agreed_to_terms_at")
  onboardingStep     String                    @default("BUSINESS_INFO") @map("onboarding_step")

  // DocuSign marketplace agreement (sent at onboarding completion).
  // Webhook flips `marketplaceAgreementSignedAt` once the envelope completes.
  marketplaceAgreementEnvelopeId String?   @map("marketplace_agreement_envelope_id")
  marketplaceAgreementSentAt     DateTime? @map("marketplace_agreement_sent_at")
  marketplaceAgreementSignedAt   DateTime? @map("marketplace_agreement_signed_at")

  // In-house electronic signature for the dealer network participation agreement.
  agreementSignature DealerAgreementSignature?

  // D1 — pickup scheduling availability (per-weekday hours, timezone, blackouts).
  availability       DealerAvailability?

  @@index([rooftopId])
  @@map("dealers")
}

model DealerAgreementSignature {
  id            String  @id @default(cuid())
  dealerId      String  @unique @map("dealer_id")

  agreementVersion String  @map("agreement_version")
  agreementHash    String  @map("agreement_hash")

  signerName     String  @map("signer_name")
  signerEmail    String  @map("signer_email")
  dealershipName String  @map("dealership_name")

  ipAddress String   @map("ip_address")
  userAgent String   @db.Text @map("user_agent")
  signedAt  DateTime @default(now()) @map("signed_at")

  consentedToElectronic Boolean @default(true) @map("consented_to_electronic")

  certificatePdfPath     String?   @map("certificate_pdf_path")
  certificateGeneratedAt DateTime? @map("certificate_generated_at")

  confirmationEmailSentAt DateTime? @map("confirmation_email_sent_at")
  confirmationEmailId     String?   @map("confirmation_email_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  dealer Dealer @relation(fields: [dealerId], references: [id], onDelete: Cascade)

  @@index([agreementVersion])
  @@index([signedAt])
  @@map("dealer_agreement_signatures")
}

model Affiliate {
  id                   String          @id @default(uuid())
  userId               String          @unique @map("user_id")
  referralCode         String          @unique @map("referral_code")
  status               AffiliateStatus @default(PENDING)
  parentId             String?         @map("parent_id")
  level                Int             @default(1)
  promotionMethod      String?         @map("promotion_method")
  website              String?
  ftcAcknowledgedAt    DateTime?       @map("ftc_acknowledged_at")
  weeklyDigestEnabled  Boolean         @default(true) @map("weekly_digest_enabled")
  lastDigestSentAt     DateTime?       @map("last_digest_sent_at")
  lastInactiveNudgeAt  DateTime?       @map("last_inactive_nudge_at")
  unsubscribeToken     String?         @unique @map("unsubscribe_token")
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")
  parent               Affiliate?      @relation("AffiliateTree", fields: [parentId], references: [id])
  children             Affiliate[]     @relation("AffiliateTree")
  user                 User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  commissions          Commission[]
  notifications        Notification[]
  payouts              AffiliatePayout[] @relation("AffiliatePayouts")
  payoutMethod         AffiliatePayoutMethod?
  documents            AffiliateDocument[]
  profile              AffiliateProfile?
  taxProfile           AffiliateTaxProfile?
  paymentProfile       AffiliatePaymentProfile?
  onboardingReview     AffiliateOnboardingReview?
  clicks               AffiliateClick[]

  @@map("affiliates")
}

model Admin {
  id                      String    @id @default(uuid())
  userId                  String    @unique @map("user_id")
  role                    AdminRole
  passwordHash            String?   @map("password_hash")   // bcrypt hash of admin password
  totpSecret              String?   @map("totp_secret")
  totpEnabled             Boolean   @default(false) @map("totp_enabled")
  recoveryCodes           String[]  @map("recovery_codes")
  pendingRecoveryCodes    String[]  @map("pending_recovery_codes")
  mfaVerifiedAt           DateTime? @map("mfa_verified_at")
  lastRecoveryCodeUsedAt  DateTime? @map("last_recovery_code_used_at")
  failedMfaAttempts       Int       @default(0) @map("mfa_failed_attempts")
  mfaLockedUntil          DateTime? @map("mfa_locked_until")
  mfaResetAt              DateTime? @map("mfa_reset_at")
  isActive                Boolean   @default(true)
  deactivatedAt           DateTime? @map("deactivated_at")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  mfaEmailTokens          AdminMfaEmailToken[]

  @@map("admins")
}

model AdminMfaEmailToken {
  id        String    @id @default(uuid())
  adminId   String    @map("admin_id")
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  admin     Admin     @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@map("admin_mfa_email_tokens")
}

model PreQualification {
  id                  String          @id @default(uuid())
  buyerId             String          @unique @map("buyer_id")
  decision            PreQualDecision
  tier                PreQualTier?
  expiresAt           DateTime        @map("expires_at")
  maxOtdAmountCents   Int             @map("max_otd_amount_cents")
  checkOfacAlert      Boolean         @default(false) @map("check_ofac_alert")
  rawResponse         String?         @map("raw_response")
  isExternal          Boolean         @default(false) @map("is_external")
  // Optional employment data — AutoLenis-internal only, never sent to MicroBilt.
  employmentStatus    String?         @map("employment_status")
  employerName        String?         @map("employer_name")
  monthlyIncomeCents  Int?            @map("monthly_income_cents")
  lengthOfEmployment  String?         @map("length_of_employment")
  // Housing + debt obligations — AutoLenis-internal only (back-end DTI inputs).
  housingStatus              String?  @map("housing_status")
  monthlyHousingPaymentCents Int?     @map("monthly_housing_payment_cents")
  monthlyOtherDebtCents      Int?     @map("monthly_other_debt_cents")
  // Decision detail (basis points — 1850 = 18.50%) for transparency.
  frontEndDtiBps             Int?     @map("front_end_dti_bps")
  backEndDtiBps              Int?     @map("back_end_dti_bps")
  benchmarkAprBps            Int?     @map("benchmark_apr_bps")
  effectiveIncomeCents       Int?     @map("effective_income_cents")
  // iPredict Advantage full response (iPredict_6.yaml): SCORES / REASONS / IDV / MLA.
  creditScore        Int?       @map("credit_score")
  idvScore           Int?       @map("idv_score")
  mlaCovered         Boolean    @default(false) @map("mla_covered")
  fraudWarning       String?    @map("fraud_warning")
  adverseReasonCodes String[]   @default([]) @map("adverse_reason_codes")
  deceasedFlag       Boolean    @default(false) @map("deceased_flag")
  bankruptcyFlag     Boolean    @default(false) @map("bankruptcy_flag")
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")
  buyer               Buyer           @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  consents            PrequalConsent[]
  complianceEvents    ComplianceEvent[]

  @@map("pre_qualifications")
}

model PrequalConsent {
  id             String           @id @default(uuid())
  prequalId     String           @map("prequal_id")
  buyerId        String           @map("buyer_id")
  consentText    String           @map("consent_text")
  acceptedAt     DateTime         @default(now()) @map("accepted_at")
  ipAddress      String?          @map("ip_address")
  userAgent      String?          @map("user_agent")
  termsVersion   String?          @map("terms_version")
  prequal        PreQualification @relation(fields: [prequalId], references: [id], onDelete: Cascade)

  @@index([prequalId])
  @@index([buyerId])
  @@map("prequal_consents")
}

model ComplianceEvent {
  id                   String            @id @default(uuid())
  eventType            String            @map("event_type")
  buyerId              String            @map("buyer_id")
  prequalApplicationId String?           @map("prequal_application_id")
  metadata             Json?
  createdAt            DateTime          @default(now()) @map("created_at")
  buyer                Buyer             @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  prequalApplication   PreQualification? @relation(fields: [prequalApplicationId], references: [id], onDelete: SetNull)

  @@index([buyerId, createdAt])
  @@index([eventType])
  @@map("compliance_events")
}

model Shortlist {
  id        String          @id @default(uuid())
  buyerId   String          @unique @map("buyer_id")
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")
  items     ShortlistItem[]
  buyer     Buyer           @relation(fields: [buyerId], references: [id], onDelete: Cascade)

  @@map("shortlists")
}

model ShortlistItem {
  id              String    @id @default(uuid())
  shortlistId     String    @map("shortlist_id")
  inventoryItemId String    @map("inventory_item_id")
  addedAt         DateTime  @default(now()) @map("added_at")
  readinessState  String    @default("AUCTION_READY") @map("readiness_state")
  shortlist       Shortlist @relation(fields: [shortlistId], references: [id], onDelete: Cascade)

  @@unique([shortlistId, inventoryItemId])
  @@map("shortlist_items")
}

model Deposit {
  id                    String        @id @default(uuid())
  buyerId               String        @map("buyer_id")
  amountCents           Int           @map("amount_cents")
  status                DepositStatus @default(PENDING)
  stripePaymentIntentId String?       @unique @map("stripe_payment_intent_id")
  stripeSessionId       String?       @unique @map("stripe_session_id")
  refundedAt            DateTime?     @map("refunded_at")
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")
  auction               Auction?
  buyer                 Buyer         @relation(fields: [buyerId], references: [id])

  @@map("deposits")
}

model Auction {
  id                String              @id @default(uuid())
  buyerId           String              @map("buyer_id")
  depositId         String              @unique @map("deposit_id")
  status            AuctionStatus       @default(PENDING)
  startedAt         DateTime?           @map("started_at")
  endsAt            DateTime?           @map("ends_at")
  closedAt          DateTime?           @map("closed_at")
  // F-001 — durable marker for the auction-close reconciler. Set (atomically)
  // once post-close side effects (load release, ranking, buyer notice,
  // zero-offer auto-refund) complete. The cron processes any CLOSED auction
  // where this is NULL, so a missed/slow tick self-heals instead of silently
  // dropping the buyer's win/no-offer notice.
  postCloseProcessedAt DateTime?        @map("post_close_processed_at")
  extendedAt        DateTime?           @map("extended_at")
  extendedBy        String?             @map("extended_by")
  extendReason      String?             @map("extend_reason")
  // Y6 — count of automatic anti-snipe extensions applied (capped). Distinct from
  // manual admin extensions; drives the MAX_AUTO_EXTENSIONS cap atomically.
  autoExtensionCount Int                @default(0) @map("auto_extension_count")
  originalAuctionId String?             @map("original_auction_id")
  // C1 — originating VehicleRequest (nullable). The admin launch path sets it
  // (buyer-ownership validated); the deposit-activation reconciler leaves it null.
  // No unique constraint: a retry auction legitimately shares its request.
  // onDelete: SetNull — an auction is a historical/financial record and must
  // survive its request being removed.
  vehicleRequestId  String?             @map("vehicle_request_id")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")
  invitations       AuctionInvitation[]
  outsideInvites    OutsideAuctionInvite[]
  vehicles          AuctionVehicle[]
  buyer             Buyer               @relation(fields: [buyerId], references: [id])
  deposit           Deposit             @relation(fields: [depositId], references: [id])
  vehicleRequest    VehicleRequest?     @relation(fields: [vehicleRequestId], references: [id], onDelete: SetNull)
  originalAuction   Auction?            @relation("AuctionRetry", fields: [originalAuctionId], references: [id])
  retryAuctions     Auction[]           @relation("AuctionRetry")
  offers            Offer[]

  @@index([vehicleRequestId])
  @@map("auctions")
}

model OutsideAuctionInvite {
  id              String    @id @default(uuid())
  auctionId       String    @map("auction_id")
  dealershipName  String    @map("dealership_name")
  contactName     String    @map("contact_name")
  email           String
  phone           String?
  token           String    @unique @default(uuid())
  // C — canonical A2 rooftop this invite targets (dedup key). Nullable: manual
  // admin invites may not resolve a rooftop. A plain soft key (no FK) so deleting
  // a rooftop never cascades into auction offer history. The mint service dedups
  // on it so one physical rooftop is invited to an auction at most once, and never
  // when its registered dealer is already invited.
  rooftopId       String?   @map("rooftop_id")
  // C — token expiry, enforced independently of auction status so a stale link
  // can't be replayed even if the auction is briefly reopened. Set to the
  // auction's endsAt at mint time.
  expiresAt       DateTime? @map("expires_at")
  sentAt          DateTime  @default(now()) @map("sent_at")
  viewedAt        DateTime? @map("viewed_at")
  respondedAt     DateTime? @map("responded_at")
  offerOtdCents   Int?      @map("offer_otd_cents")
  offerVehicleCents Int?    @map("offer_vehicle_cents")
  offerTaxCents   Int?      @map("offer_tax_cents")
  offerFeesCents  Int?      @map("offer_fees_cents")
  offerNotes      String?   @map("offer_notes")
  // Link to the real Offer record created when this outside dealer responds,
  // so the offer flows through the best-price engine and buyer comparison.
  offerId         String?   @unique @map("offer_id")
  auction         Auction   @relation(fields: [auctionId], references: [id], onDelete: Cascade)

  @@index([auctionId])
  // C — DB backstop for the "one rooftop invited to an auction at most once" dedup
  // invariant (mint's read-then-create is otherwise TOCTOU under concurrency).
  // Postgres treats NULLs as distinct, so manual null-rooftop invites are never
  // blocked; only a repeated non-null rooftop on the same auction collides.
  @@unique([auctionId, rooftopId])
  @@map("outside_auction_invites")
}

model AuctionVehicle {
  id              String         @id @default(uuid())
  auctionId       String         @map("auction_id")
  inventoryItemId String?        @map("inventory_item_id")
  year            Int?
  make            String?
  model           String?
  trim            String?
  mileage         Int?
  notes           String?
  createdAt       DateTime       @default(now()) @map("created_at")
  auction         Auction        @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id])

  @@index([auctionId])
  @@map("auction_vehicles")
}

model AuctionInvitation {
  id              String    @id @default(uuid())
  auctionId       String    @map("auction_id")
  dealerId        String    @map("dealer_id")
  invitationScore Float?    @map("invitation_score")
  sentAt          DateTime  @default(now()) @map("sent_at")
  viewedAt        DateTime? @map("viewed_at")
  respondedAt     DateTime? @map("responded_at")
  auction         Auction   @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  dealer          Dealer    @relation("DealerInvitations", fields: [dealerId], references: [id])

  @@unique([auctionId, dealerId])
  @@map("auction_invitations")
}

model Offer {
  id                String      @id @default(uuid())
  auctionId         String      @map("auction_id")
  dealerId          String      @map("dealer_id")
  status            OfferStatus @default(DRAFT)
  otdPriceCents     Int         @map("otd_price_cents")
  vehiclePriceCents Int         @map("vehicle_price_cents")
  taxCents          Int         @default(0) @map("tax_cents")
  feesCents         Int         @default(0) @map("fees_cents")
  junkFeeItems      Json        @default("[]") @map("junk_fee_items")
  includesFinancing Boolean     @default(false) @map("includes_financing")
  aprRate           Float?      @map("apr_rate")
  termMonths        Int?        @map("term_months")
  bestPriceScore    Float?      @map("best_price_score")
  rankCash          Int?        @map("rank_cash")
  rankMonthly       Int?        @map("rank_monthly")
  rankBalanced      Int?        @map("rank_balanced")
  aprFlag           String?     @map("apr_flag")
  version           Int         @default(1)
  originalOfferId   String?     @unique @map("original_offer_id")
  submittedAt       DateTime?   @map("submitted_at")
  // Outside / unregistered dealer support. When an offer is submitted on behalf
  // of a dealer that has no Dealer account, `dealerId` points to the system
  // "Outside Dealer" placeholder and these fields carry the real identity.
  externalDealerName  String?   @map("external_dealer_name")
  externalDealerEmail String?   @map("external_dealer_email")
  externalDealerPhone String?   @map("external_dealer_phone")
  notes               String?
  // Set when an admin entered this offer manually on behalf of a dealer.
  submittedByAdminId  String?   @map("submitted_by_admin_id")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")
  deal              Deal?
  auction           Auction     @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  dealer            Dealer      @relation(fields: [dealerId], references: [id])
