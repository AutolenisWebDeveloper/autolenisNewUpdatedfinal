model Pickup {
  id          String       @id @default(uuid())
  dealId      String       @unique @map("deal_id")
  status      PickupStatus @default(NOT_SCHEDULED)
  scheduledAt DateTime?    @map("scheduled_at")
  completedAt DateTime?    @map("completed_at")
  location    String?
  qrCodeData  String?      @map("qr_code_data")
  qrCodeImage String?      @map("qr_code_image")
  qrExpiresAt DateTime?    @map("qr_expires_at")
  // D2 — confirm/propose round-trip. `proposedTime` is the pending slot awaiting
  // the other party; `proposedBy` is "BUYER" | "DEALER" (String, not an enum,
  // mirroring Dealer.tier). `proposedAt` doubles as the compare-and-swap token
  // for atomic transitions (anti-snipe idiom). On confirm/accept the agreed slot
  // moves to `scheduledAt`. `counterCount` caps the ping-pong (2 → admin).
  proposedTime           DateTime? @map("proposed_time")
  proposedBy             String?   @map("proposed_by")
  proposedAt             DateTime? @map("proposed_at")
  counterCount           Int       @default(0) @map("counter_count")
  // SLA-nudge markers (D2b cron): reset on each new proposal, one nudge per side.
  proposedReminderSentAt DateTime? @map("proposed_reminder_sent_at")
  counterReminderSentAt  DateTime? @map("counter_reminder_sent_at")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  deal        Deal         @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([status, proposedAt])
  @@map("pickups")
}

