  variantLabel  String   @map("variant_label") // "A", "B", "C"
  isWinner      Boolean  @default(false) @map("is_winner")
  score         Float    @default(0)
  createdAt     DateTime @default(now()) @map("created_at")

  @@unique([groupId, postId])
  @@index([groupId])
  @@map("ab_test_variants")
}

