// ─── Dealer Application & Invitation (Area 1 & 3) ────────────────────────────

enum DealerApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DealerInvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  CANCELLED
}

model DealerApplication {
  id             String                  @id @default(uuid())
  dealershipName String                  @map("dealership_name")
  dealershipType String                  @map("dealership_type")
  state          String
  city           String
  zip            String
  licenseNumber  String                  @map("license_number")
  contactName    String                  @map("contact_name")
  contactEmail   String                  @map("contact_email")
  contactPhone   String?                 @map("contact_phone")
  annualVolume   String?                 @map("annual_volume")
  notes          String?
  status         DealerApplicationStatus @default(PENDING)
  reviewedBy     String?                 @map("reviewed_by")
  reviewedAt     DateTime?               @map("reviewed_at")
  rejectReason   String?                 @map("reject_reason")
  dealerId       String?                 @unique @map("dealer_id")
  createdAt      DateTime                @default(now()) @map("created_at")
  updatedAt      DateTime                @updatedAt @map("updated_at")

  @@index([status])
  @@map("dealer_applications")
}

model DealerInvitation {
  id              String                 @id @default(uuid())
  dealershipName  String                 @map("dealership_name")
  contactName     String                 @map("contact_name")
  email           String
  personalMessage String?                @map("personal_message")
  token           String                 @unique
  expiresAt       DateTime               @map("expires_at")
  status          DealerInvitationStatus @default(PENDING)
  invitedBy       String                 @map("invited_by")
  acceptedAt      DateTime?              @map("accepted_at")
  dealerId        String?                @unique @map("dealer_id")
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")

  @@index([status])
  @@index([token])
  @@map("dealer_invitations")
}

// ─── Vehicle Offer System ─────────────────────────────────────────────────
// Admin-generated dealer offer links. Multiple dealers can submit competing
// offers for one buyer request. Each submission may include up to 3 vehicle
// alternatives. Buyers review selected offers via tokenized links and
// accept/decline individually.

model VehicleOffer {
  id                  String    @id @default(uuid())
  token               String    @unique @default(uuid())

  // Vehicle details (admin fills)
  vehicleYear         Int       @map("vehicle_year")
  vehicleMake         String    @map("vehicle_make")
  vehicleModel        String    @map("vehicle_model")
  vehicleTrim         String?   @map("vehicle_trim")
  vehicleMileage      Int?      @map("vehicle_mileage")
  vehicleVin          String?   @map("vehicle_vin")
  vehicleColor        String?   @map("vehicle_color")
  vehicleInteriorColor String?  @map("vehicle_interior_color")
  vehicleCondition    String    @map("vehicle_condition")
  askingPriceCents    Int?      @map("asking_price_cents")
  vehicleReferenceUrl String?   @map("vehicle_reference_url")

  // Buyer context
  buyerName           String?   @map("buyer_name")
  buyerEmail          String?   @map("buyer_email")
  buyerPhone          String?   @map("buyer_phone")
  buyerCity           String?   @map("buyer_city")
  buyerState          String?   @map("buyer_state")
  buyerZip            String    @map("buyer_zip")
  buyerBudget         String    @map("buyer_budget")
  buyerMonthlyPayment String?   @map("buyer_monthly_payment")
  buyerDownPayment    String?   @map("buyer_down_payment")
  buyerNewOrUsed      String    @map("buyer_new_or_used")
  buyerFinancing      String    @map("buyer_financing")
  buyerTimeline       String?   @map("buyer_timeline")
  buyerOpenToAlt      Boolean   @default(false) @map("buyer_open_to_alt")
  buyerMustHave       String?   @map("buyer_must_have")
  buyerDrivetrain     String?   @map("buyer_drivetrain")
  buyerFuelType       String?   @map("buyer_fuel_type")
  buyerMaxMileage     String?   @map("buyer_max_mileage")
  buyerSeating        String?   @map("buyer_seating")
  buyerInteriorColor  String?   @map("buyer_interior_color")

  // Trade-in from buyer
  buyerHasTradeIn     Boolean   @default(false) @map("buyer_has_trade_in")
  buyerTradeYear      String?   @map("buyer_trade_year")
  buyerTradeMake      String?   @map("buyer_trade_make")
  buyerTradeModel     String?   @map("buyer_trade_model")
  buyerTradeMileage   String?   @map("buyer_trade_mileage")
  buyerTradePayoff    String?   @map("buyer_trade_payoff")
  buyerTradeCondition String?   @map("buyer_trade_condition")
  buyerTradeVin       String?   @map("buyer_trade_vin")
  buyerTradeAccident  String?   @map("buyer_trade_accident")

  adminNotes          String?   @map("admin_notes")
  referenceId         String?   @map("reference_id")
  requestStatus       String    @default("new") @map("request_status")
  expiresAt           DateTime? @map("expires_at")
  createdByAdminId    String    @map("created_by_admin_id")
  createdAt           DateTime  @default(now()) @map("created_at")

  submissions         DealerOfferSubmission[]
  buyerReviews        BuyerOfferReview[]
  dealerInvites       VehicleOfferDealerInvite[]

  @@map("vehicle_offers")
}

model VehicleOfferDealerInvite {
  id             String    @id @default(uuid())
  vehicleOfferId String    @map("vehicle_offer_id")
  token          String    @unique @default(uuid())

  dealershipName String    @map("dealership_name")
  contactName    String?   @map("contact_name")
  dealerEmail    String    @map("dealer_email")
  dealerPhone    String?   @map("dealer_phone")

  status         String    @default("sent")
  sentAt         DateTime  @default(now()) @map("sent_at")
  openedAt       DateTime? @map("opened_at")
  submittedAt    DateTime? @map("submitted_at")
  expiresAt      DateTime? @map("expires_at")

  vehicleOffer   VehicleOffer @relation(fields: [vehicleOfferId], references: [id], onDelete: Cascade)
  submission     DealerOfferSubmission? @relation(fields: [submissionId], references: [id])
  submissionId   String? @unique @map("submission_id")

  @@index([token])
  @@index([vehicleOfferId])
  @@map("vehicle_offer_dealer_invites")
}

model DealerOfferSubmission {
  id             String   @id @default(uuid())
  vehicleOfferId String   @map("vehicle_offer_id")
  dealershipName String   @map("dealership_name")
  contactName    String   @map("contact_name")
  contactEmail   String   @map("contact_email")
  contactPhone   String   @map("contact_phone")
  vehicles       Json
  notes          String?
  submittedAt    DateTime @default(now()) @map("submitted_at")
  inviteId       String?  @unique @map("invite_id")
  rejected       Boolean  @default(false)
  rejectedAt     DateTime? @map("rejected_at")
  dealerId       String?  @map("dealer_id")
  documents      Json?    // Array of { url, name, type, sizeBytes }

  vehicleOffer   VehicleOffer @relation(fields: [vehicleOfferId], references: [id], onDelete: Cascade)
  dealer         Dealer?  @relation(fields: [dealerId], references: [id])
  reviewItems    BuyerOfferReviewItem[]
  invite         VehicleOfferDealerInvite?

  @@index([dealerId])
  @@map("dealer_offer_submissions")
}

model BuyerOfferReview {
  id             String    @id @default(uuid())
  reviewToken    String    @unique @default(uuid()) @map("review_token")
  vehicleOfferId String    @map("vehicle_offer_id")
  buyerEmail     String    @map("buyer_email")
  buyerName      String    @map("buyer_name")
  adminMessage   String?   @map("admin_message")
  sentAt         DateTime  @default(now()) @map("sent_at")
  expiresAt      DateTime? @map("expires_at")

  vehicleOffer   VehicleOffer @relation(fields: [vehicleOfferId], references: [id], onDelete: Cascade)
  items          BuyerOfferReviewItem[]

  @@map("buyer_offer_reviews")
}

model BuyerOfferReviewItem {
  id                 String    @id @default(uuid())
  buyerOfferReviewId String    @map("buyer_offer_review_id")
  dealerSubmissionId String    @map("dealer_submission_id")
  vehicleIndex       Int       @default(0) @map("vehicle_index")
  status             String    @default("PENDING")
  respondedAt        DateTime? @map("responded_at")
  buyerNote          String?   @map("buyer_note")

  review     BuyerOfferReview      @relation(fields: [buyerOfferReviewId], references: [id], onDelete: Cascade)
  submission DealerOfferSubmission @relation(fields: [dealerSubmissionId], references: [id], onDelete: Cascade)

  @@map("buyer_offer_review_items")
}

// ─── AI Buyer Acquisition ────────────────────────────────────────────────────
// Persists conversational finder sessions, scoring snapshots, and SMS
// opt-out preferences. Conversations may belong to an authenticated Buyer
// or remain anonymous (buyerId null) until phone match resolves identity.

model Conversation {
  id            String   @id @default(cuid())
  sessionId     String   @unique @map("session_id")
  buyerId       String?  @map("buyer_id")
  buyer         Buyer?   @relation(fields: [buyerId], references: [id])
  transcript    Json     @default("[]")
  completed     Boolean  @default(false)
  extractedData Json?    @map("extracted_data")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("acquisition_conversations")
}

model BuyerOpportunity {
  id              String   @id @default(cuid())
  sessionId       String   @unique @map("session_id")
  conversationId  String?  @map("conversation_id")

  // Buyer identification
  buyerId         String?  @map("buyer_id")
  buyer           Buyer?   @relation(fields: [buyerId], references: [id])
  phone           String?
  firstName       String?  @map("first_name")
  email           String?  @map("email")

  // Group 5 — entry-point provenance for this opportunity.
  source          String?  @map("source")
  // Zura intelligence — classified intent for the inbound call. One of
  // vehicle_request / question / status_check / message / dealer_inquiry /
  // transfer_request / other. Null for non-voice opportunities.
  callReason      String?  @map("call_reason")
  // Inverse relation — canonical VehicleRequest(s) linked to this opportunity.
  vehicleRequests VehicleRequest[]

  // Vehicle interest
  vehicleType     String?  @map("vehicle_type")
  make            String?
  model           String?
  bodyStyle       String?  @map("body_style")
  yearMin         Int?     @map("year_min")
  yearMax         Int?     @map("year_max")
  trim            String?

  // Financial
  budgetType      String?  @map("budget_type")
  budgetAmount    Int?     @map("budget_amount")
  monthlyPayment  Int?     @map("monthly_payment")

  // Timeline + location
  timeline        String?
  zip             String?

  // Trade-in
  hasTradeIn      Boolean? @map("has_trade_in")
  tradeInDetails  Json?    @map("trade_in_details")

  // Financing
  financingNeeded Boolean? @map("financing_needed")

  // Market enrichment (from groq/compound web search)
  marketMsrpEstimate    Int?     @map("market_msrp_estimate")
  marketAvgPaidPrice    Int?     @map("market_avg_paid_price")
  marketTypicalMarkup   String?  @map("market_typical_markup")
  marketGoodDealTarget  Int?     @map("market_good_deal_target")
  marketNotes           String?  @db.Text @map("market_notes")
  marketEnrichedAt      DateTime? @map("market_enriched_at")

  // Dealer discovery (relation)
  dealerProspects       DealerProspect[]

  // Conversation
  messages        Json     @default("[]")
  completed       Boolean  @default(false)

  // Lead scoring
  leadScore       Int?     @map("lead_score")
  leadTemperature String?  @map("lead_temperature")
  scoringReason   String?  @map("scoring_reason") @db.Text

  // Status
  founderNotified Boolean  @default(false) @map("founder_notified")
  buyerSmsSent    Boolean  @default(false) @map("buyer_sms_sent")
  buyerEmailSent      Boolean  @default(false) @map("buyer_email_sent")
  founderEmailSent    Boolean  @default(false) @map("founder_email_sent")

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([buyerId])
  @@index([leadTemperature])
  @@index([createdAt])
  @@index([source])
  @@index([callReason])
  @@map("buyer_opportunities")
}

model DealerProspect {
  id              String   @id @default(cuid())

  // Relation back to BuyerOpportunity
  buyerOppId      String   @map("buyer_opp_id")
  buyerOpp        BuyerOpportunity @relation(fields: [buyerOppId], references: [id], onDelete: Cascade)

  // Dealer details (from web search)
  name            String
  address         String?
  city            String?
  state           String?
  zip             String?
  phone           String?
  email           String?
  website         String?

  // What they sell
  brand           String?  // Toyota, Honda, etc.

  // Search metadata
  sourceUrl       String?  @map("source_url")
  searchScore     Float?   @map("search_score")
  distanceMiles   Float?   @map("distance_miles")

  // Recruitment workflow
  status          DealerProspectStatus @default(DISCOVERED)
  outreachDraft   String?  @db.Text @map("outreach_draft")
  contactedAt     DateTime? @map("contacted_at")
  repliedAt       DateTime? @map("replied_at")

  // Phase 4A — Founder-driven phone outreach
  outreachScript        String?   @db.Text @map("outreach_script")
  scriptDraftedAt       DateTime? @map("script_drafted_at")
  scriptAttempts        Int       @default(0) @map("script_attempts")
  founderNotes          String?   @db.Text @map("founder_notes")

  // Status timestamps
  scriptedAt            DateTime? @map("scripted_at")
  // (contactedAt and repliedAt already exist above)
  onboardedAt           DateTime? @map("onboarded_at")
  deadAt                DateTime? @map("dead_at")
  deadReason            String?   @map("dead_reason")

  // Phase 4B-3 — Email outreach send log (relation)
  outreachLog     DealerOutreachLog[]

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([buyerOppId])
  @@index([status])
  @@index([zip])
  @@map("dealer_prospects")
}

// Phase 4B-3 — Dealer Outreach Log.
// Records every outreach attempt (initial + followups) so sends are auditable,
// rate-limited, and reconcilable against Resend delivery webhooks.
model DealerOutreachLog {
  id                 String   @id @default(uuid())
  dealerProspectId   String   @map("dealer_prospect_id")
  outreachType       String   @map("outreach_type")  // 'initial' | 'followup_1' | 'followup_2'
  channel            String                           // 'email' | 'sms' | 'phone'
  subject            String?
  body               String?  @db.Text
  toEmail            String?  @map("to_email")
  fromEmail          String?  @map("from_email")
  resendId           String?  @map("resend_id")
  status             String                           // 'queued' | 'sent' | 'delivered' | 'bounced' | 'replied' | 'complained' | 'failed'
  errorMessage       String?  @db.Text @map("error_message")
  sentAt             DateTime  @default(now()) @map("sent_at")
  deliveredAt        DateTime? @map("delivered_at")
  repliedAt          DateTime? @map("replied_at")
  metadata           Json      @default("{}")

  dealerProspect     DealerProspect @relation(fields: [dealerProspectId], references: [id], onDelete: Cascade)

  @@index([dealerProspectId])
  @@index([status])
  @@index([sentAt])
  @@index([resendId])
  @@map("dealer_outreach_log")
}

enum DealerProspectStatus {
  DISCOVERED
  SCRIPTED      // AI script drafted, ready for founder to call
  DRAFTED       // KEEP for forward compatibility (email phase)
  CONTACTED     // Founder called the dealer
  REPLIED       // Dealer responded
  ONBOARDED     // Dealer signed up
  DEAD          // No interest or unreachable
}

model SearchCache {
  id          String   @id @default(cuid())

  // Cache key components
  cacheKey    String   @unique @map("cache_key")
  searchType  String   @map("search_type")  // "market_enrichment" | "dealer_discovery"
  zip         String?
  make        String?
  model       String?
  radiusMiles Int?     @map("radius_miles")

  // Cached result
  result      Json

  // TTL
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([cacheKey])
  @@index([expiresAt])
  @@map("search_cache")
}

model LeadScore {
  id          String   @id @default(cuid())
  buyerId     String?  @map("buyer_id")
  sessionId   String?  @map("session_id")
  score       Int
  temperature String
  signals     Json
  reasoning   String
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("lead_scores")
}

model SmsOptOut {
  id        String   @id @default(cuid())
  phone     String   @unique
  reason    String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("sms_opt_outs")
}
