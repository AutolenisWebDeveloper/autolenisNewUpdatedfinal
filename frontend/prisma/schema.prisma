// ─── Dealer Application & Invitation (Area 1 & 3) ────────────────────────────

enum DealerApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DealerInvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  CANCELLED
}

model DealerApplication {
  id             String                  @id @default(uuid())
  dealershipName String                  @map("dealership_name")
  dealershipType String                  @map("dealership_type")
  state          String
  city           String
  zip            String
  licenseNumber  String                  @map("license_number")
  contactName    String                  @map("contact_name")
  contactEmail   String                  @map("contact_email")
  contactPhone   String?                 @map("contact_phone")
  annualVolume   String?                 @map("annual_volume")
  notes          String?
  status         DealerApplicationStatus @default(PENDING)
  reviewedBy     String?                 @map("reviewed_by")
  reviewedAt     DateTime?               @map("reviewed_at")
  rejectReason   String?                 @map("reject_reason")
  dealerId       String?                 @unique @map("dealer_id")
  createdAt      DateTime                @default(now()) @map("created_at")
  updatedAt      DateTime                @updatedAt @map("updated_at")

  @@index([status])
  @@map("dealer_applications")
}

model DealerInvitation {
  id              String                 @id @default(uuid())
  dealershipName  String                 @map("dealership_name")
  contactName     String                 @map("contact_name")
  email           String
  personalMessage String?                @map("personal_message")
  token           String                 @unique
  expiresAt       DateTime               @map("expires_at")
  status          DealerInvitationStatus @default(PENDING)
  invitedBy       String                 @map("invited_by")
  acceptedAt      DateTime?              @map("accepted_at")
  dealerId        String?                @unique @map("dealer_id")
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")

  @@index([status])
  @@index([token])
  @@map("dealer_invitations")
}

// WO-2 — Secure dealer account-claim token.
// Issued when an admin approves a DealerApplication. The dealer's Supabase user
// is created WITHOUT a known password; this single-use, hashed, 7-day token lets
// the dealer set their own password via /dealer/claim. We store ONLY the SHA-256
// hash of the token — the plaintext exists only in the emailed claim link.
model DealerAccountClaimToken {
  id               String    @id @default(uuid())
  // SHA-256 hash of the raw token. The raw token is never persisted.
  tokenHash        String    @unique @map("token_hash")
  dealerId         String    @map("dealer_id")
  applicationId    String?   @map("application_id")
  expiresAt        DateTime  @map("expires_at")
  consumedAt       DateTime? @map("consumed_at")
  createdByAdminId String    @map("created_by_admin_id")
  createdAt        DateTime  @default(now()) @map("created_at")

  @@index([tokenHash])
  @@index([dealerId])
  @@map("dealer_account_claim_tokens")
}

// ─── Vehicle Offer System ─────────────────────────────────────────────────
// Admin-generated dealer offer links. Multiple dealers can submit competing
// offers for one buyer request. Each submission may include up to 3 vehicle
// alternatives. Buyers review selected offers via tokenized links and
// accept/decline individually.

model VehicleOffer {
  id                  String    @id @default(uuid())
  token               String    @unique @default(uuid())

  // Vehicle details (admin fills)
  vehicleYear         Int       @map("vehicle_year")
  vehicleMake         String    @map("vehicle_make")
  vehicleModel        String    @map("vehicle_model")
  vehicleTrim         String?   @map("vehicle_trim")
  vehicleMileage      Int?      @map("vehicle_mileage")
  vehicleVin          String?   @map("vehicle_vin")
  vehicleColor        String?   @map("vehicle_color")
  vehicleInteriorColor String?  @map("vehicle_interior_color")
  vehicleCondition    String    @map("vehicle_condition")
  askingPriceCents    Int?      @map("asking_price_cents")
  vehicleReferenceUrl String?   @map("vehicle_reference_url")

  // Buyer context
  buyerName           String?   @map("buyer_name")
  buyerEmail          String?   @map("buyer_email")
  buyerPhone          String?   @map("buyer_phone")
  buyerCity           String?   @map("buyer_city")
  buyerState          String?   @map("buyer_state")
  buyerZip            String    @map("buyer_zip")
  buyerBudget         String    @map("buyer_budget")
  buyerMonthlyPayment String?   @map("buyer_monthly_payment")
  buyerDownPayment    String?   @map("buyer_down_payment")
  buyerNewOrUsed      String    @map("buyer_new_or_used")
  buyerFinancing      String    @map("buyer_financing")
  buyerTimeline       String?   @map("buyer_timeline")
  buyerOpenToAlt      Boolean   @default(false) @map("buyer_open_to_alt")
  buyerMustHave       String?   @map("buyer_must_have")
  buyerDrivetrain     String?   @map("buyer_drivetrain")
  buyerFuelType       String?   @map("buyer_fuel_type")
  buyerMaxMileage     String?   @map("buyer_max_mileage")
  buyerSeating        String?   @map("buyer_seating")
  buyerInteriorColor  String?   @map("buyer_interior_color")

  // Trade-in from buyer
  buyerHasTradeIn     Boolean   @default(false) @map("buyer_has_trade_in")
  buyerTradeYear      String?   @map("buyer_trade_year")
  buyerTradeMake      String?   @map("buyer_trade_make")
  buyerTradeModel     String?   @map("buyer_trade_model")
  buyerTradeMileage   String?   @map("buyer_trade_mileage")
  buyerTradePayoff    String?   @map("buyer_trade_payoff")
  buyerTradeCondition String?   @map("buyer_trade_condition")
  buyerTradeVin       String?   @map("buyer_trade_vin")
  buyerTradeAccident  String?   @map("buyer_trade_accident")

  adminNotes          String?   @map("admin_notes")
  referenceId         String?   @map("reference_id")
  requestStatus       String    @default("new") @map("request_status")
  expiresAt           DateTime? @map("expires_at")
  createdByAdminId    String    @map("created_by_admin_id")
  createdAt           DateTime  @default(now()) @map("created_at")

  submissions         DealerOfferSubmission[]
  buyerReviews        BuyerOfferReview[]
  dealerInvites       VehicleOfferDealerInvite[]

  @@map("vehicle_offers")
}

model VehicleOfferDealerInvite {
  id             String    @id @default(uuid())
  vehicleOfferId String    @map("vehicle_offer_id")
  token          String    @unique @default(uuid())

  dealershipName String    @map("dealership_name")
  contactName    String?   @map("contact_name")
  dealerEmail    String    @map("dealer_email")
  dealerPhone    String?   @map("dealer_phone")

  status         String    @default("sent")
  sentAt         DateTime  @default(now()) @map("sent_at")
  openedAt       DateTime? @map("opened_at")
  submittedAt    DateTime? @map("submitted_at")
  expiresAt      DateTime? @map("expires_at")

  vehicleOffer   VehicleOffer @relation(fields: [vehicleOfferId], references: [id], onDelete: Cascade)
  submission     DealerOfferSubmission? @relation(fields: [submissionId], references: [id])
  submissionId   String? @unique @map("submission_id")

  @@index([token])
  @@index([vehicleOfferId])
  @@map("vehicle_offer_dealer_invites")
}

model DealerOfferSubmission {
  id             String   @id @default(uuid())
  vehicleOfferId String   @map("vehicle_offer_id")
  dealershipName String   @map("dealership_name")
  contactName    String   @map("contact_name")
  contactEmail   String   @map("contact_email")
  contactPhone   String   @map("contact_phone")
  vehicles       Json
  notes          String?
  submittedAt    DateTime @default(now()) @map("submitted_at")
  inviteId       String?  @unique @map("invite_id")
  rejected       Boolean  @default(false)
  rejectedAt     DateTime? @map("rejected_at")
  dealerId       String?  @map("dealer_id")
  documents      Json?    // Array of { url, name, type, sizeBytes }

  vehicleOffer   VehicleOffer @relation(fields: [vehicleOfferId], references: [id], onDelete: Cascade)
  dealer         Dealer?  @relation(fields: [dealerId], references: [id])
  reviewItems    BuyerOfferReviewItem[]
  invite         VehicleOfferDealerInvite?

  @@index([dealerId])
  @@map("dealer_offer_submissions")
}

model BuyerOfferReview {
  id             String    @id @default(uuid())
  reviewToken    String    @unique @default(uuid()) @map("review_token")
  vehicleOfferId String    @map("vehicle_offer_id")
  buyerEmail     String    @map("buyer_email")
  buyerName      String    @map("buyer_name")
  adminMessage   String?   @map("admin_message")
  sentAt         DateTime  @default(now()) @map("sent_at")
  expiresAt      DateTime? @map("expires_at")

  vehicleOffer   VehicleOffer @relation(fields: [vehicleOfferId], references: [id], onDelete: Cascade)
  items          BuyerOfferReviewItem[]

  @@map("buyer_offer_reviews")
}

model BuyerOfferReviewItem {
  id                 String    @id @default(uuid())
  buyerOfferReviewId String    @map("buyer_offer_review_id")
  dealerSubmissionId String    @map("dealer_submission_id")
  vehicleIndex       Int       @default(0) @map("vehicle_index")
  status             String    @default("PENDING")
  respondedAt        DateTime? @map("responded_at")
  buyerNote          String?   @map("buyer_note")

  review     BuyerOfferReview      @relation(fields: [buyerOfferReviewId], references: [id], onDelete: Cascade)
  submission DealerOfferSubmission @relation(fields: [dealerSubmissionId], references: [id], onDelete: Cascade)

  @@map("buyer_offer_review_items")
}

// ─── AI Buyer Acquisition ────────────────────────────────────────────────────
// Persists conversational finder sessions, scoring snapshots, and SMS
// opt-out preferences. Conversations may belong to an authenticated Buyer
// or remain anonymous (buyerId null) until phone match resolves identity.

model Conversation {
  id            String   @id @default(cuid())
  sessionId     String   @unique @map("session_id")
  buyerId       String?  @map("buyer_id")
  buyer         Buyer?   @relation(fields: [buyerId], references: [id])
  transcript    Json     @default("[]")
  completed     Boolean  @default(false)
  extractedData Json?    @map("extracted_data")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("acquisition_conversations")
}

model BuyerOpportunity {
  id              String   @id @default(cuid())
  sessionId       String   @unique @map("session_id")
  conversationId  String?  @map("conversation_id")

  // Buyer identification
  buyerId         String?  @map("buyer_id")
  buyer           Buyer?   @relation(fields: [buyerId], references: [id])
  phone           String?
  firstName       String?  @map("first_name")
  email           String?  @map("email")

  // SMS marketing consent (TCPA) — provisioned via manual Supabase migration.
  // Gates the weekly market-alert SMS in the social-optimize cron.
  consentSms      Boolean?  @map("consent_sms")
  consentAt       DateTime? @map("consent_at")

  // Group 5 — entry-point provenance for this opportunity.
  source          String?  @map("source")
  // Zura intelligence — classified intent for the inbound call. One of
  // vehicle_request / question / status_check / message / dealer_inquiry /
  // transfer_request / other. Null for non-voice opportunities.
  callReason      String?  @map("call_reason")
  // Inverse relation — canonical VehicleRequest(s) linked to this opportunity.
  vehicleRequests VehicleRequest[]
  // Phase C-Attribution — content-engine leads attributed to this opportunity.
  contentAttributions ContentAttribution[]

  // Vehicle interest
  vehicleType     String?  @map("vehicle_type")
  make            String?
  model           String?
  bodyStyle       String?  @map("body_style")
  yearMin         Int?     @map("year_min")
  yearMax         Int?     @map("year_max")
  trim            String?

  // Financial
  budgetType      String?  @map("budget_type")
  budgetAmount    Int?     @map("budget_amount")
  monthlyPayment  Int?     @map("monthly_payment")

  // Timeline + location
  timeline        String?
  zip             String?

  // Trade-in
  hasTradeIn      Boolean? @map("has_trade_in")
  tradeInDetails  Json?    @map("trade_in_details")

  // Financing
  financingNeeded Boolean? @map("financing_needed")

  // Market enrichment (from groq/compound web search)
  marketMsrpEstimate    Int?     @map("market_msrp_estimate")
  marketAvgPaidPrice    Int?     @map("market_avg_paid_price")
  marketTypicalMarkup   String?  @map("market_typical_markup")
  marketGoodDealTarget  Int?     @map("market_good_deal_target")
  marketNotes           String?  @db.Text @map("market_notes")
  marketEnrichedAt      DateTime? @map("market_enriched_at")

  // S1/S2 — set when the durable intake pipeline (autolenis/intake.process)
  // completes. NULL = never finished; the intake-reconcile cron re-drives such
  // rows. Distinct from marketEnrichedAt (a legit intake can enrich yet find
  // zero dealers), so this is the unambiguous "intake done" marker.
  intakeProcessedAt     DateTime? @map("intake_processed_at")

  // Batch 2 — trustworthy completion semantics. A REQUIRED sourcing-spine stage
  // (dealer discovery / outreach) that FAILS to EXECUTE no longer masquerades as
  // completion: intake is NOT stamped, `intakeAttempts` is incremented, and after
  // MAX_INTAKE_ATTEMPTS the intake is dead-lettered by setting `intakeFailedAt`
  // (+ a sanitized `intakeFailureReason`). The intake-reconcile eligibility query
  // excludes rows with intakeFailedAt set, so a provider outage can never make the
  // cron re-drive one forever. Terminal state lives HERE (never in jobs_dead_letter),
  // so the Inngest-based DLQ drainer can never re-emit a terminal intake. ZERO_RESULTS
  // (dealer discovery ran, found none) is a VALID completion and never dead-letters.
  intakeAttempts        Int       @default(0) @map("intake_attempts")
  intakeFailedAt        DateTime? @map("intake_failed_at")
  intakeFailureReason   String?   @db.Text @map("intake_failure_reason")

  // Dealer discovery (relation)
  dealerProspects       DealerProspect[]

  // Conversation
  messages        Json     @default("[]")
  completed       Boolean  @default(false)

  // Lead scoring
  leadScore       Int?     @map("lead_score")
  leadTemperature String?  @map("lead_temperature")
  scoringReason   String?  @map("scoring_reason") @db.Text

  // Status
  founderNotified Boolean  @default(false) @map("founder_notified")
  buyerSmsSent    Boolean  @default(false) @map("buyer_sms_sent")
  buyerEmailSent      Boolean  @default(false) @map("buyer_email_sent")
  founderEmailSent    Boolean  @default(false) @map("founder_email_sent")

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([buyerId])
  @@index([leadTemperature])
  @@index([createdAt])
  @@index([source])
  @@index([callReason])
  @@map("buyer_opportunities")
}

// A2 (Block A / unified sourcing) — canonical physical rooftop. One row per real
// dealership location; registered Dealers and DealerProspects both resolve to it
// via the shared dealer-identity keys, so the same dealership is never
// double-invited (internal AuctionInvitation + outside token). Normalized
// identity keys are persisted so lookup is a direct indexed query. `makes` is a
// READ-ONLY signal (from DealerCapacityConfig.preferredMakes for registered
// dealers, brand/discovery for prospects) — the rooftop never writes preferredMakes.
model DealerRooftop {
  id               String           @id @default(cuid())
  displayName      String           @map("display_name")
  nameKey          String           @map("name_key")
  // Strongest identity key — unique so two candidates on the same real domain
  // can never create two rooftops (Postgres treats NULLs as distinct, so
  // host-less rooftops are unconstrained). name+zip races are a noted follow-up.
  websiteHost      String?          @unique @map("website_host")
  phoneKey         String?          @map("phone_key")
  nameZipKey       String?          @map("name_zip_key")
  nameCityStateKey String?          @map("name_city_state_key")
  zip              String?
  city             String?
  state            String?
  latitude         Float?
  longitude        Float?
  makes            String[]         @default([])
  // Provenance of `makes`: "preferred_makes" (registered dealer) | "prospect_brand" | null
  makesSource      String?          @map("makes_source")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  dealers          Dealer[]
  prospects        DealerProspect[]
  contacts         DealerContactProfile[]

  // websiteHost lookups are served by its @unique index (above) — no separate
  // @@index (that would drift from the migration, which creates only the unique).
  @@index([phoneKey])
  @@index([nameZipKey])
  @@index([nameCityStateKey])
  @@map("dealer_rooftops")
}

// Block B / Apollo — reserve-and-release monthly credit ledger. One row per
// billing cycle; the atomic draw is a conditional updateMany guarded on
// spentCredits (no raw SQL), so two concurrent/retried reveals can never
// overspend. reserve/release is computed from the cycle day at draw time.
model ApolloCreditLedger {
  id           String   @id @default(cuid())
  cycleKey     String   @unique @map("cycle_key") // "YYYY-MM"
  capCredits   Int      @map("cap_credits") // monthly cap (set from the live probe)
  spentCredits Int      @default(0) @map("spent_credits")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("apollo_credit_ledger")
}

// Block B / Apollo — reveal cache + idempotency claim. Unique on
// (rooftopId, cycleKey): a concurrent/retried reveal for the same rooftop in a
// cycle cannot double-draw (only the INSERT winner proceeds to draw), and
// revealedAt drives the freshness window (never re-reveal a fresh rooftop).
model ApolloReveal {
  id           String    @id @default(cuid())
  rooftopId    String    @map("rooftop_id")
  cycleKey     String    @map("cycle_key")
  creditsCost  Int       @default(0) @map("credits_cost")
  consumer     String    @default("live") // "live" | "backfill"
  status       String    @default("PENDING") // PENDING | REVEALED | EMPTY
  email        String?
  emailStatus  String?   @map("email_status")
  contactName  String?   @map("contact_name")
  contactTitle String?   @map("contact_title")
  revealedAt   DateTime  @default(now()) @map("revealed_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@unique([rooftopId, cycleKey])
  @@index([rooftopId])
  @@map("apollo_reveals")
}

// Block B / B1 — person-level dealer contact identity, keyed to the canonical A2
// DealerRooftop so a registered Dealer and its prospect twin share ONE contact
// history (not a per-Dealer / per-Prospect re-split). Reconciled from the
// denormalized DealerProspect contact.* fields; the single home for the contact
// waterfall's results, staleness re-checks (lastVerifiedAt), and Block B
// shared-inbox collapse (emailKey). Cascade-deleted with its rooftop.
model DealerContactProfile {
  id        String        @id @default(cuid())
  rooftopId String        @map("rooftop_id")
  rooftop   DealerRooftop @relation(fields: [rooftopId], references: [id], onDelete: Cascade)

  // Person identity
  name    String?
  nameKey String? @map("name_key") // normalizeDealerName(name) — in-rooftop dedup
  title   String?

  // Contact channels (original value kept for display; *Key normalized for match)
  email    String?
  emailKey String? @map("email_key") // normalizeEmail(email) — dedup + shared-inbox anchor (B2)
  phone    String?
  phoneKey String? @map("phone_key") // normalizePhone(phone)

  // Provenance + verification — mirrors the DealerProspect taxonomy so the
  // contact waterfall's SEND_SAFE_STATUSES ({VERIFIED, ROLE_DERIVED}) reads the
  // same labels. emailVerificationStatus is never written down from a stronger
  // value (see the service merge rules).
  emailSource             String?   @map("email_source")
  emailVerificationStatus String?   @map("email_verification_status")
  emailVerifiedAt         DateTime? @map("email_verified_at")
  contactSource           String?   @map("contact_source")
  contactConfidence       String?   @map("contact_confidence")

  // Staleness anchor for the Block B CONTACT_STALE_MONTHS re-check.
  lastVerifiedAt DateTime? @map("last_verified_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Composite serves both the FK (rooftopId prefix) and the in-rooftop
  // email-dedup lookup; emailKey alone serves cross-rooftop shared-inbox scans.
  @@index([rooftopId, emailKey])
  @@index([emailKey])
  @@map("dealer_contact_profiles")
}

model DealerProspect {
  id              String   @id @default(cuid())

  // Relation back to BuyerOpportunity. Optional: AMIPS bulk dealer discovery
  // (Gemini Maps / Apollo imports) has no originating buyer, so prospects from
  // those sources are created with buyerOppId = null. Buyer-intake prospects
  // still pass a real buyerOppId.
  buyerOppId      String?  @map("buyer_opp_id")
  buyerOpp        BuyerOpportunity? @relation(fields: [buyerOppId], references: [id], onDelete: Cascade)

  // Dealer details (from web search)
  name            String
  address         String?
  city            String?
  state           String?
  zip             String?
  phone           String?
  email           String?
  website         String?

  // What they sell
  brand           String?  // Toyota, Honda, etc.

  // Search metadata
  sourceUrl       String?  @map("source_url")
  searchScore     Float?   @map("search_score")
  distanceMiles   Float?   @map("distance_miles")
  // Y5 — geocoded coordinates (from ZIP via the geocoding adapter). Nullable +
  // backfilled; used by unified-sourcing distance math instead of static ZIP maps.
  latitude        Float?   @map("latitude")
  longitude       Float?   @map("longitude")
  // A2 — resolved canonical rooftop (cross-pool dedup). Nullable; SetNull on delete.
  rooftopId       String?  @map("rooftop_id")
  rooftop         DealerRooftop? @relation(fields: [rooftopId], references: [id], onDelete: SetNull)

  // Recruitment workflow
  status          DealerProspectStatus @default(DISCOVERED)
  outreachDraft   String?  @db.Text @map("outreach_draft")
  contactedAt     DateTime? @map("contacted_at")
  repliedAt       DateTime? @map("replied_at")

  // Phase 4A — Founder-driven phone outreach
  outreachScript        String?   @db.Text @map("outreach_script")
  scriptDraftedAt       DateTime? @map("script_drafted_at")
  scriptAttempts        Int       @default(0) @map("script_attempts")
  founderNotes          String?   @db.Text @map("founder_notes")

  // Phase 4B-1 — Dealer email enrichment via Gemini Search grounding.
  // `email` already exists above (Dealer details block). These track where the
  // address came from and when enrichment last ran.
  // emailSource values: "gemini_search_high_confidence" |
  // "gemini_search_medium_confidence" | "gemini_search_inferred" |
  // "fallback_info_email" | "role_derived" (A3 — inferred role inbox) | "manual"
  emailSource           String?   @map("email_source")
  emailEnrichedAt       DateTime? @map("email_enriched_at")
  // Y1 — verify-before-persist email acquisition. `emailVerifiedAt` is stamped
  // only when an address passed MX-deliverability AND was not hard-suppressed.
  // emailVerificationStatus values (plain string, not an enum):
  //   VERIFIED | ROLE_DERIVED (A3 — MX-deliverable but inferred, NOT person-verified) |
  //   UNVERIFIED | SUPPRESSED | DUPLICATE | NONE
  //   {VERIFIED, ROLE_DERIVED} == send-safe / contactable for coverage + mint.
  emailVerifiedAt         DateTime? @map("email_verified_at")
  emailVerificationStatus String?   @map("email_verification_status")
  // Contact person behind the email (Internet Sales Manager, etc.) — captured
  // by the Phase 4B-1 enrichment and used to personalize outreach greetings.
  contactName           String?   @map("contact_name")
  contactTitle          String?   @map("contact_title")

  // WO-3 — the Internet Sales Manager is now a first-class extraction, persisted
  // INDEPENDENTLY of whether a verifiable email was found. These mirror the email
  // provenance taxonomy so a found-contact-without-email is still imported.
  // contactSource values: "gemini_search_high_confidence" |
  //   "gemini_search_medium_confidence" | "gemini_search_inferred" |
  //   "gemini_maps_discovery" | "manual"
  // contactConfidence values: "high" | "medium" | "low"
  contactPhone          String?   @map("contact_phone")
  contactSourceUrl      String?   @map("contact_source_url")
  contactSource         String?   @map("contact_source")
  contactConfidence     String?   @map("contact_confidence")
  contactEnrichedAt     DateTime? @map("contact_enriched_at")

  // Status timestamps
  scriptedAt            DateTime? @map("scripted_at")
  // (contactedAt and repliedAt already exist above)
  onboardedAt           DateTime? @map("onboarded_at")
  deadAt                DateTime? @map("dead_at")
  deadReason            String?   @map("dead_reason")

  // Phase 4B-3 — dealer outreach email send history.
  outreachLog     DealerOutreachLog[]

  // Phase 4B-4 — reply detection + follow-up sequencing.
  // replyDetectedAt: set when a dealer reply/engagement is detected.
  // sequencePausedAt / sequencePauseReason: stop the follow-up cadence.
  //   reasons: 'bounced' | 'opted_out' | 'replied' | 'manual'
  replyDetectedAt       DateTime? @map("reply_detected_at")
  sequencePausedAt      DateTime? @map("sequence_paused_at")
  sequencePauseReason   String?   @map("sequence_pause_reason")

  // F-010 — one-click recruitment claim. A high-entropy token is minted when a
  // prospect is contacted; the outreach email links to it so a responding
  // dealer self-converts into a (pre-filled) DealerApplication instead of
  // re-entering everything on the public form. convertedApplicationId marks the
  // prospect ONBOARDED and makes the claim idempotent.
  claimToken             String?   @unique @map("claim_token")
  claimTokenExpiresAt    DateTime? @map("claim_token_expires_at")
  convertedApplicationId String?   @map("converted_application_id")

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([buyerOppId])
  @@index([status])
  @@index([zip])
  @@index([email])
  @@index([rooftopId])
  @@map("dealer_prospects")
}

// Phase 4B-3 — one row per outreach attempt (email/sms/phone) to a dealer
// prospect. Tracks Resend delivery lifecycle and powers rate limiting.
model DealerOutreachLog {
  id                 String    @id @default(uuid())
  dealerProspectId   String    @map("dealer_prospect_id")
  outreachType       String    @map("outreach_type")   // initial | followup_1 | followup_2
  channel            String                             // email | sms | phone
  subject            String?
  body               String?   @db.Text
  toEmail            String?   @map("to_email")
  fromEmail          String?   @map("from_email")
  resendId           String?   @map("resend_id")
  status             String                             // queued | sent | delivered | bounced | replied | complained | failed
  errorMessage       String?   @db.Text @map("error_message")
  sentAt             DateTime  @default(now()) @map("sent_at")
  deliveredAt        DateTime? @map("delivered_at")
  repliedAt          DateTime? @map("replied_at")
  metadata           Json      @default("{}")

  // Phase 4B-4 — multi-touch follow-up sequencing.
  // outreachSequenceStep: 1 = initial, 2 = follow-up 1, 3 = follow-up 2.
  outreachSequenceStep Int?      @default(1) @map("outreach_sequence_step")
  followUpScheduledAt  DateTime? @map("follow_up_scheduled_at")
  replyDetectedAt      DateTime? @map("reply_detected_at")

  dealerProspect     DealerProspect @relation(fields: [dealerProspectId], references: [id], onDelete: Cascade)

  @@index([dealerProspectId])
  @@index([status])
  @@index([sentAt])
  @@index([resendId])
  @@index([outreachSequenceStep])
  @@map("dealer_outreach_log")
}

enum DealerProspectStatus {
  DISCOVERED
  SCRIPTED      // AI script drafted, ready for founder to call
  DRAFTED       // KEEP for forward compatibility (email phase)
  CONTACTED     // Founder called the dealer
  REPLIED       // Dealer responded
  ONBOARDED     // Dealer signed up
  DEAD          // No interest or unreachable
}

model SearchCache {
  id          String   @id @default(cuid())

  // Cache key components
  cacheKey    String   @unique @map("cache_key")
  searchType  String   @map("search_type")  // "market_enrichment" | "dealer_discovery"
  zip         String?
  make        String?
  model       String?
  radiusMiles Int?     @map("radius_miles")

  // Cached result
  result      Json

  // TTL
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([cacheKey])
  @@index([expiresAt])
  @@map("search_cache")
}

model LeadScore {
  id          String   @id @default(cuid())
  buyerId     String?  @map("buyer_id")
  sessionId   String?  @map("session_id")
  score       Int
  temperature String
  signals     Json
  reasoning   String
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("lead_scores")
}

model SmsOptOut {
  id        String   @id @default(cuid())
  phone     String   @unique
  reason    String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("sms_opt_outs")
}

// Phase C1 — programmatic SEO content engine. One row per buying-guide article
// (dealer quotes, OTD price, dealer fees, trade-in, leasing) generated for a
// city/state in a national wave. Generation happens in Phase C2; this model is
// the storage + lifecycle layer that the /buying-guide/[slug] route reads from.
model ContentArticle {
  id              String        @id @default(cuid())
  slug            String        @unique
  cluster         String        // dealer_quotes|otd_price|dealer_fees|trade_in|leasing
  make            String?       // "Toyota"
  model           String?       // "Camry"
  city            String        // "Dallas"
  state           String        // "TX"
  metro           String?       // "Dallas-Fort Worth" — for grouping
  wave            Int           @default(1) // 1, 2, or 3
  targetKeyword   String        @map("target_keyword")
  title           String
  metaDescription String        @map("meta_description")
  h1              String
  body            String        @db.Text
  faqJson         String?       @map("faq_json") @db.Text
  wordCount       Int?          @map("word_count")
  authorSlug      String        @default("markist") @map("author_slug")
  status          ArticleStatus @default(DRAFT)
  qualityScore    Int?          @map("quality_score")
  qualityFlags    String?       @map("quality_flags") @db.Text
  publishedAt     DateTime?     @map("published_at")
  generatedAt     DateTime?     @map("generated_at")
  groqModel       String?       @map("groq_model")
  searchGrounded  Boolean?      @map("search_grounded")

  // --- Phase 1 (Bulk Article → Content Ops) field extensions ---
  // Scheduling / approval. NOTE: we deliberately do NOT add a SCHEDULED enum
  // value. Editorial status stays DRAFT/REVIEW_NEEDED/PUBLISHED/ARCHIVED; a
  // "scheduled" article is status=REVIEW_NEEDED|DRAFT with a non-null
  // scheduledAt + approvedAt, and the content-publisher cron flips it to
  // PUBLISHED when due. This mirrors how AMIPS separates editorial status from
  // lifecycleStatus and keeps the public page + sitemap PUBLISHED filters intact.
  scheduledAt          DateTime? @map("scheduled_at")
  approvedAt           DateTime? @map("approved_at")
  approvedByAdminId    String?   @map("approved_by_admin_id")
  lastPublishedAt      DateTime? @map("last_published_at")
  publishFailureReason String?   @map("publish_failure_reason") @db.Text
  publicationVersion   Int       @default(1) @map("publication_version")
  // Indexation governance.
  canonicalUrl         String?   @map("canonical_url")
  noindex              Boolean   @default(false)
  // Featured media (populated by the media Inngest function).
  featuredImageUrl         String?   @map("featured_image_url")
  featuredImageAlt         String?   @map("featured_image_alt")
  featuredImageStatus      String?   @map("featured_image_status")
  featuredImagePrompt      String?   @map("featured_image_prompt") @db.Text
  featuredImageProvider    String?   @map("featured_image_provider")
  featuredImageGeneratedAt DateTime? @map("featured_image_generated_at")
  // Refresh / validation lifecycle (ported from AMIPS naming).
  lifecycleStatus String    @default("ACTIVE") @map("lifecycle_status")
  refreshDueAt    DateTime? @map("refresh_due_at")
  lastValidatedAt DateTime? @map("last_validated_at")
  lastRefreshedAt DateTime? @map("last_refreshed_at")

  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  // Domain ledger relations (written by Inngest functions / services).
  versions           ContentArticleVersion[]
  generationJobItems ContentGenerationJobItem[]
  validationResults  ContentValidationResult[]
  mediaAssets        ContentMediaAsset[]
  workflowEvents     ContentWorkflowEvent[]

  @@index([cluster])
  @@index([status])
  @@index([city, state])
  @@index([metro])
  @@index([wave])
  @@index([publishedAt])
  @@index([scheduledAt])
  @@index([refreshDueAt])
  @@index([lifecycleStatus])
  @@index([cluster, status])
  @@index([metro, status])
  @@index([noindex])
  @@map("content_articles")
}

enum ArticleStatus {
  DRAFT
  REVIEW_NEEDED
  PUBLISHED
  ARCHIVED
}

// Status shared by content generation jobs and their per-article items.
// Inngest owns locking/retry/backoff — these are observability states the
// functions write, NOT a competing scheduler (no lockedAt/lockedBy/nextRunAt).
enum ContentJobStatus {
  QUEUED
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELED
  PAUSED
}

// ---------------------------------------------------------------------------
// Content Ops domain ledger (Phase 1 / WO-2 model layer).
// These tables are observability + history records written BY the content
// Inngest functions and services. They reuse the existing idempotency_keys /
// jobs_dead_letter infrastructure (raw SQL, see migrations/01) — they do NOT
// fork a second idempotency table, dead-letter table, or queue runtime.
// ---------------------------------------------------------------------------

// Immutable snapshot of an article's editorial fields. A new row is written on
// every generate / regenerate / edit / publish / rollback so history is durable
// and rollback is exact.
model ContentArticleVersion {
  id                   String         @id @default(cuid())
  articleId            String         @map("article_id")
  article              ContentArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  versionNumber        Int            @map("version_number")
  title                String
  h1                   String
  metaDescription      String         @map("meta_description")
  body                 String         @db.Text
  faqJson              String?        @map("faq_json") @db.Text
  qualityScore         Int?           @map("quality_score")
  complianceResultJson String?        @map("compliance_result_json") @db.Text
  generatedByModel     String?        @map("generated_by_model")
  createdByAdminId     String?        @map("created_by_admin_id")
  createdByJobId       String?        @map("created_by_job_id")
  changeReason         String?        @map("change_reason")
  createdAt            DateTime       @default(now()) @map("created_at")

  @@unique([articleId, versionNumber])
  @@index([articleId, versionNumber])
  @@map("content_article_versions")
}

// Batch header for a bulk generation/regeneration/validation/media run. The
// admin UI reads this for live batch progress.
model ContentGenerationJob {
  id               String                     @id @default(cuid())
  status           ContentJobStatus           @default(QUEUED)
  jobType          String                     @map("job_type") // generate | regenerate | validate | media
  totalItems       Int                        @default(0) @map("total_items")
  succeededItems   Int                        @default(0) @map("succeeded_items")
  failedItems      Int                        @default(0) @map("failed_items")
  createdByAdminId String?                    @map("created_by_admin_id")
  filterJson       String?                    @map("filter_json") @db.Text
  lastError        String?                    @map("last_error") @db.Text
  startedAt        DateTime?                  @map("started_at")
  completedAt      DateTime?                  @map("completed_at")
  createdAt        DateTime                   @default(now()) @map("created_at")
  updatedAt        DateTime                   @updatedAt @map("updated_at")
  items            ContentGenerationJobItem[]

  @@index([status])
  @@index([jobType])
  @@index([createdAt])
  @@map("content_generation_jobs")
}

// Per-article work item. `idempotencyKey` is the stable content identity used to
// reuse the idempotency_keys guard so retries converge to one article, never a
// duplicate slug. No lock columns — Inngest owns retry/backoff.
model ContentGenerationJobItem {
  id             String               @id @default(cuid())
  jobId          String               @map("job_id")
  job            ContentGenerationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  status         ContentJobStatus     @default(QUEUED)
  attemptCount   Int                  @default(0) @map("attempt_count")
  lastError      String?              @map("last_error") @db.Text
  idempotencyKey String               @map("idempotency_key")
  inngestRunId   String?              @map("inngest_run_id")
  articleId      String?              @map("article_id")
  article        ContentArticle?      @relation(fields: [articleId], references: [id], onDelete: SetNull)
  targetSlug     String?              @map("target_slug")
  payloadJson    String?              @map("payload_json") @db.Text
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  @@index([jobId, status])
  @@index([status])
  @@index([articleId])
  @@index([idempotencyKey])
  @@map("content_generation_job_items")
}

// One row per validation run. checkResultsJson holds the per-layer pass/fail.
model ContentValidationResult {
  id                  String         @id @default(cuid())
  articleId           String         @map("article_id")
  article             ContentArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  checkResultsJson    String         @map("check_results_json") @db.Text
  passed              Boolean        @default(false)
  overriddenByAdminId String?        @map("overridden_by_admin_id")
  overrideReason      String?        @map("override_reason") @db.Text
  createdAt           DateTime       @default(now()) @map("created_at")

  @@index([articleId])
  @@index([articleId, createdAt])
  @@map("content_validation_results")
}

// A generated/uploaded media asset for an article (featured image, etc.).
model ContentMediaAsset {
  id        String         @id @default(cuid())
  articleId String         @map("article_id")
  article   ContentArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  provider  String?
  status    String         @default("PENDING")
  width     Int?
  height    Int?
  bytes     Int?
  prompt    String?        @db.Text
  createdAt DateTime       @default(now()) @map("created_at")

  @@index([articleId])
  @@index([status])
  @@map("content_media_assets")
}

// Append-only audit of workflow transitions (generate, validate, approve,
// schedule, publish, rollback, override, …). Complements admin_audit_log with
// content-domain detail.
model ContentWorkflowEvent {
  id          String          @id @default(cuid())
  articleId   String?         @map("article_id")
  article     ContentArticle? @relation(fields: [articleId], references: [id], onDelete: SetNull)
  jobId       String?         @map("job_id")
  eventType   String          @map("event_type")
  actor       String
  payloadJson String?         @map("payload_json") @db.Text
  createdAt   DateTime        @default(now()) @map("created_at")

  @@index([articleId])
  @@index([jobId])
  @@index([eventType])
  @@index([createdAt])
  @@map("content_workflow_events")
}

// Phase C-Attribution — links a content-engine lead back to the buying-guide
// article that drove it (cluster / city / state / metro), so conversions can be
// reported by content dimension. A row is created at lead time from the
// first-party attribution cookie set on buying-guide pages. Conversion is
// reconciled from the linked BuyerOpportunity (a paid deposit or a created
// deal); the denormalized converted* fields let a webhook fast-path GA4 and
// keep the reporting query trivial.
model ContentAttribution {
  id                   String    @id @default(cuid())
  // The buying-guide article that drove the lead.
  articleSlug          String    @map("article_slug")
  cluster              String
  city                 String
  state                String
  metro                String?
  // Which lead surface captured the conversion (mirrors BuyerOpportunity.source).
  source               String
  // Soft link to the canonical lead record (application-enforced, no cascade).
  buyerOpportunityId   String?            @map("buyer_opportunity_id")
  buyerOpportunity     BuyerOpportunity?  @relation(fields: [buyerOpportunityId], references: [id])
  email                String?
  leadTemperature      String?   @map("lead_temperature")
  // Denormalized conversion outcome — set by reconcile/webhook.
  converted            Boolean   @default(false)
  convertedAt          DateTime? @map("converted_at")
  conversionValueCents Int?      @map("conversion_value_cents")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  @@index([cluster])
  @@index([city, state])
  @@index([metro])
  @@index([articleSlug])
  @@index([buyerOpportunityId])
  @@index([converted])
  @@map("content_attributions")
}

// =====================================================
// AMIPS — AutoLenis Market Intelligence Publishing System
// Phase 0 — Data Foundation. Six intelligence databases plus
// the content queue and the AMIPS page store. The database is the
// asset; the article is the delivery mechanism. No data populated =
// no article generated. Kept fully separate from content_articles.
// =====================================================

// AMIPS Database 1 — Vehicle Intelligence.
// MSRP + computed fair-market pricing per make/model/trim/year,
// sourced from manufacturer public sites. Populated first.
model VehicleIntelligence {
  id                    String    @id @default(cuid())
  make                  String
  model                 String
  trim                  String?
  year                  Int
  msrpCents             Int       @map("msrp_cents")
  fairMarketLowCents    Int       @map("fair_market_low_cents")
  fairMarketHighCents   Int       @map("fair_market_high_cents")
  aggressiveTargetCents Int       @map("aggressive_target_cents")
  activeIncentives      String?   @map("active_incentives") @db.Text
  incentivesExpiresAt   DateTime? @map("incentives_expires_at")
  financingNotes        String?   @map("financing_notes") @db.Text
  leaseNotes            String?   @map("lease_notes") @db.Text
  negotiationDifficulty String    @map("negotiation_difficulty")
  dataSource            String    @map("data_source")
  lastUpdated           DateTime  @default(now()) @map("last_updated")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@unique([make, model, trim, year])
  @@index([make, model])
  @@index([lastUpdated])
  @@map("vehicle_intelligence")
}

// AMIPS Database 2 — Dealer Intelligence.
// Derived from the existing Gemini Maps dealer cache (DealerProspect).
// Density score = same-brand dealers within 30 miles. Populated second.
model DealerIntelligence {
  id                  String    @id @default(cuid())
  dealerName          String    @map("dealer_name")
  brand               String
  city                String
  state               String
  zip                 String
  latitude            Float?
  longitude           Float?
  website             String?
  inventorySignal     String    @default("normal") @map("inventory_signal")
  dealerDensityScore  Float?    @map("dealer_density_score")
  dealersWithin30mi   Int?      @map("dealers_within_30mi")
  dataSource          String    @map("data_source")
  lastUpdated         DateTime  @default(now()) @map("last_updated")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  @@index([brand, city, state])
  @@index([state])
  @@index([lastUpdated])
  @@map("dealer_intelligence")
}

// AMIPS Database 3 — Market Intelligence.
// Metro-level demand/competition/inventory/leverage scores computed
// from Census population + Dealer Intelligence. Populated second.
model MarketIntelligence {
  id                 String   @id @default(cuid())
  metroName          String   @map("metro_name")
  state              String
  population         Int?
  vehicleDemandScore Float?   @map("vehicle_demand_score")
  competitionScore   Float?   @map("competition_score")
  inventoryScore     Float?   @map("inventory_score")
  buyerLeverageScore Float?   @map("buyer_leverage_score")
  seasonalNotes      String?  @map("seasonal_notes") @db.Text
  lastUpdated        DateTime @default(now()) @map("last_updated")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@unique([metroName, state])
  @@index([state])
  @@index([buyerLeverageScore])
  @@map("market_intelligence")
}

// AMIPS Database 4 — AutoLenis Intelligence.
// Proprietary platform transaction aggregates per metro + vehicle +
// month. Schema only at launch; populated from live transactions later.
model AutolenisIntelligence {
  id                      String   @id @default(cuid())
  metro                   String
  vehicleMake             String   @map("vehicle_make")
  vehicleModel            String   @map("vehicle_model")
  requestVolume           Int      @default(0) @map("request_volume")
  dealerResponseRate      Float?   @map("dealer_response_rate")
  avgOffersReceived       Float?   @map("avg_offers_received")
  verifiedSavingsAvgCents Int?     @map("verified_savings_avg_cents")
  offerWinRate            Float?   @map("offer_win_rate")
  transactionCount        Int      @default(0) @map("transaction_count")
  periodMonth             String   @map("period_month")
  lastUpdated             DateTime @default(now()) @map("last_updated")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  @@unique([metro, vehicleMake, vehicleModel, periodMonth])
  @@index([metro])
  @@index([transactionCount])
  @@map("autolenis_intelligence")
}

// AMIPS Database 5 — Search Intelligence.
// Weekly Google Search Console metrics per AMIPS URL. Schema only at
// launch; populated once pages publish and GSC accumulates data.
model SearchIntelligence {
  id                 String   @id @default(cuid())
  url                String
  contentTier        String   @map("content_tier")
  searchImpressions  Int      @default(0) @map("search_impressions")
  clicks             Int      @default(0)
  ctr                Float?
  avgPosition        Float?   @map("avg_position")
  indexedStatus      Boolean  @default(false) @map("indexed_status")
  leadsGenerated     Int      @default(0) @map("leads_generated")
  conversionRate     Float?   @map("conversion_rate")
  revenueAttribution Int      @default(0) @map("revenue_attribution")
  weekOf             DateTime @map("week_of")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@unique([url, weekOf])
  @@index([contentTier])
  @@index([weekOf])
  @@index([leadsGenerated])
  @@map("search_intelligence")
}

// AMIPS Database 6 — Marketplace Intelligence.
// One row per completed live buyer/dealer transaction. Powers Tier F.
// Schema only at launch; populated from real deals later.
model MarketplaceIntelligence {
  id                      String   @id @default(cuid())
  vehicleMake             String   @map("vehicle_make")
  vehicleModel            String   @map("vehicle_model")
  vehicleTrim             String?  @map("vehicle_trim")
  metro                   String
  dealersInvited          Int      @default(0) @map("dealers_invited")
  dealersResponded        Int      @default(0) @map("dealers_responded")
  responseRate            Float?   @map("response_rate")
  timeToFirstOfferMinutes Int?     @map("time_to_first_offer_minutes")
  timeToFinalOfferMinutes Int?     @map("time_to_final_offer_minutes")
  buyerAcceptedOffer      Boolean? @map("buyer_accepted_offer")
  avgOffersPerRequest     Float?   @map("avg_offers_per_request")
  leadToRequestConversion Float?   @map("lead_to_request_conversion")
  requestToDealConversion Float?   @map("request_to_deal_conversion")
  transactionDate         DateTime @map("transaction_date")
  buyerOpportunityId      String?  @map("buyer_opportunity_id")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  @@index([vehicleMake, vehicleModel])
  @@index([metro])
  @@index([transactionDate])
  @@map("marketplace_intelligence")
}

// AMIPS — Content Queue.
// Priority-ordered backlog of pages to generate. priorityScore is
// computed from the launch opportunity formula (population-based) and
// later upgraded to search-demand-based once Search Intelligence matures.
model ContentQueue {
  id             String    @id @default(cuid())
  priorityScore  Float     @map("priority_score")
  contentTier    String    @map("content_tier")
  make           String?
  model          String?
  metro          String?
  state          String?
  intentTemplate String    @map("intent_template") @db.Text
  keywordTarget  String    @map("keyword_target")
  status         String    @default("pending")
  failureReason  String?   @map("failure_reason") @db.Text
  scheduledDate  DateTime? @map("scheduled_date")
  contentPageId  String?   @map("content_page_id")
  attempts       Int       @default(0)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([status, priorityScore])
  @@index([contentTier])
  @@index([scheduledDate])
  @@map("content_queue")
}

// AMIPS — Content Pages.
// The published page store. Every factual claim traces to a data field;
// dataTokenCount + qualityGateStatus enforce the "no data, no article"
// rule. Kept fully separate from content_articles (Phase C2 system).
model AmipsPage {
  id                String    @id @default(cuid())
  slug              String    @unique
  contentTier       String    @map("content_tier")
  make              String?
  model             String?
  metro             String?
  state             String?
  title             String
  metaDescription   String    @map("meta_description")
  h1                String
  body              String    @db.Text
  faqJson           String?   @map("faq_json") @db.Text
  marketScoreJson   String?   @map("market_score_json") @db.Text
  dataTokenCount    Int       @default(0) @map("data_token_count")
  ctaType           String    @map("cta_type")
  lifecycleStatus   String    @default("ACTIVE") @map("lifecycle_status")
  qualityGateStatus String    @map("quality_gate_status")
  qualityGateFlags  String?   @map("quality_gate_flags") @db.Text
  vehicleDataAsOf   DateTime? @map("vehicle_data_as_of")
  dealerDataAsOf    DateTime? @map("dealer_data_as_of")
  marketDataAsOf    DateTime? @map("market_data_as_of")
  publishedAt       DateTime? @map("published_at")
  lastRefreshedAt   DateTime? @map("last_refreshed_at")
  impressions       Int       @default(0)
  clicks            Int       @default(0)
  leadsGenerated    Int       @default(0) @map("leads_generated")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@index([contentTier, lifecycleStatus])
  @@index([make, model, metro])
  @@index([publishedAt])
  @@index([lifecycleStatus])
  @@map("amips_pages")
}

// AMIPS Phase 1 — Market Score cache.
// Pre-computed AutoLenis Market Score per (make, model, metro) so article
// generation reads a stored score instead of recomputing on the fly. Refreshed
// by the market-score batch pipeline whenever dealer/market data changes.
model AmipsMarketScore {
  id                    String   @id @default(cuid())
  make                  String
  model                 String
  metro                 String
  state                 String
  dealerCount           Int      @default(0) @map("dealer_count")
  overallBuyerAdvantage Float    @map("overall_buyer_advantage")
  scoreJson             String   @map("score_json") @db.Text
  computedAt            DateTime @default(now()) @map("computed_at")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@unique([make, model, metro])
  @@index([metro])
  @@index([overallBuyerAdvantage])
  @@map("amips_market_scores")
}

// AMIPS Phase 5 — Intelligence Snapshots.
// A periodic point-in-time capture of the executive-intelligence rollup so the
// Market Intelligence Center can show genuine trends (day-over-day / week-over-
// week deltas) instead of static figures. Written daily by the snapshot cron;
// the full computed payload is stored as JSON alongside trended scalar columns.
model AmipsIntelligenceSnapshot {
  id                  String   @id @default(cuid())
  capturedAt          DateTime @default(now()) @map("captured_at")
  healthScore         Int      @map("health_score")
  metrosCovered       Int      @map("metros_covered")
  metrosScored        Int      @map("metros_scored")
  avgBuyerLeverage    Float    @map("avg_buyer_leverage")
  activePages         Int      @map("active_pages")
  published30d        Int      @map("published_30d")
  impressions         Int      @default(0)
  clicks              Int      @default(0)
  leads               Int      @default(0)
  revenueRunRateCents Int      @default(0) @map("revenue_run_rate_cents")
  indexationRate      Float    @default(0) @map("indexation_rate")
  payloadJson         String   @map("payload_json") @db.Text
  createdAt           DateTime @default(now()) @map("created_at")

  @@index([capturedAt])
  @@map("amips_intelligence_snapshots")
}

// =====================================================
// Social Intelligence & Media Engine (Session 1)
// Full-automation content/video/publishing/attribution pipeline.
// Reads from existing AMIPS + content + vehicle-request intelligence;
// never modifies it. Kept self-contained under the social_* tables.
// =====================================================

// Franchise definitions seeded at startup — recurring content programs.
model ContentFranchise {
  id              String   @id @default(cuid())
  slug            String   @unique
  name            String
  description     String?  @db.Text
  platforms       String[] // ["facebook","instagram","tiktok","youtube","linkedin"]
  cadence         String   // "daily" | "weekly" | "tuesday" | "friday"
  postingSlots    Int[]    @map("posting_slots") // [7, 12, 19] — hours in CT
  hookTypes       String[] @map("hook_types") // preferred hook types
  requiresReview  Boolean  @default(false) @map("requires_review")
  active          Boolean  @default(true)
  avgLeadScore    Float?   @map("avg_lead_score")
  postsGenerated  Int      @default(0) @map("posts_generated")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  posts           SocialPost[]

  @@map("content_franchises")
}

// Signals from AMIPS and platform data that trigger content generation.
model TopicSignal {
  id              String    @id @default(cuid())
  signalType      String    @map("signal_type")
  make            String?
  model           String?
  city            String?
  metro           String?
  state           String?
  signalValue     Float?    @map("signal_value")
  signalDelta     Float?    @map("signal_delta")
  signalContext   Json      @default("{}") @map("signal_context")
  sourceTable     String?   @map("source_table")
  sourceId        String?   @map("source_id")
  assetsGenerated Boolean   @default(false) @map("assets_generated")
  assetCount      Int       @default(0) @map("asset_count")
  detectedAt      DateTime  @default(now()) @map("detected_at")
  expiresAt       DateTime? @map("expires_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  posts           SocialPost[]
  derivatives     ContentDerivative[]

  @@index([signalType])
  @@index([make, model, city])
  @@index([assetsGenerated])
  @@index([detectedAt])
  @@map("topic_signals")
}

// Core post record — every generated asset is a SocialPost.
model SocialPost {
  id              String   @id @default(cuid())

  franchiseId     String?  @map("franchise_id")
  franchise       ContentFranchise? @relation(fields: [franchiseId], references: [id])
  signalId        String?  @map("signal_id")
  signal          TopicSignal? @relation(fields: [signalId], references: [id])

  sourceArticleId String?  @map("source_article_id")
  sourceVehicleRequestId String? @map("source_vehicle_request_id")

  platform        String
  contentType     String   @map("content_type")
  hookType        String?  @map("hook_type")

  hook            String   @db.Text
  script          String   @db.Text
  caption         String   @db.Text
  hashtags        String[]
  ctaText         String?  @map("cta_text")
  ctaPlacement    String?  @map("cta_placement")
  visualPrompt    String?  @db.Text @map("visual_prompt")
  visualStyle     String?  @map("visual_style")
  voiceoverText   String?  @db.Text @map("voiceover_text")
  onScreenText    String?  @db.Text @map("on_screen_text")
  durationSeconds Int?     @map("duration_seconds")

  geoTarget       String?  @map("geo_target")
  make            String?
  model           String?
  metro           String?
  state           String?

  funnelDestination String? @map("funnel_destination")

  utmSource       String?  @map("utm_source")
  utmMedium       String?  @map("utm_medium")
  utmCampaign     String?  @map("utm_campaign")
  utmContent      String?  @map("utm_content")
  utmTerm         String?  @map("utm_term")
  utmHook         String?  @map("utm_hook")
  utmPlatform     String?  @map("utm_platform")
  trackedUrl      String?  @map("tracked_url")

  complianceNotes String?  @db.Text @map("compliance_notes")
  requiresReview  Boolean  @default(false) @map("requires_review")

  automationMode  String   @default("HYBRID_AUTO") @map("automation_mode")

  status          SocialPostStatus @default(DRAFT)
  rejectionReason String?  @db.Text @map("rejection_reason")

  scheduledAt     DateTime? @map("scheduled_at")
  publishedAt     DateTime? @map("published_at")

  publishingProvider String? @map("publishing_provider")
  platformPostId  String?  @map("platform_post_id")
  publishError    String?  @db.Text @map("publish_error")
  publishAttempts Int      @default(0) @map("publish_attempts")

  leadScore       Int      @default(0) @map("lead_score")

