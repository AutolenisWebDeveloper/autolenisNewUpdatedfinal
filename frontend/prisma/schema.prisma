generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id         String     @id @default(uuid())
  supabaseId String     @unique @map("supabase_id")
  email      String     @unique
  role       UserRole
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")
  admin      Admin?
  affiliate  Affiliate?
  buyer      Buyer?
  dealer     Dealer?
  sessions   Session[]
  acceptedTerms AcceptedTerms[]
  requiresPasswordChange Boolean @default(false) @map("requires_password_change")

  @@map("users")
}

model Buyer {
  id                 String               @id @default(uuid())
  userId             String               @unique @map("user_id")
  firstName          String               @map("first_name")
  lastName           String               @map("last_name")
  phone              String?
  address            String?
  city               String?
  state              String?
  zip                String?
  onboardingComplete Boolean              @default(false) @map("onboarding_complete")
  termsAcceptedAt    DateTime?            @map("terms_accepted_at")
  termsVersion       String?              @map("terms_version")
  profilePictureUrl  String?              @map("profile_picture_url")
  employmentStatus   String?              @map("employment_status")
  incomeRange        String?              @map("income_range")
  affiliateId        String?              @map("affiliate_id")
  plan               BuyerPlan            @default(STANDARD)
  planUpgradedAt     DateTime?            @map("plan_upgraded_at")
  // Lifecycle management — set by admin actions
  archivedAt         DateTime?            @map("archived_at")
  disabledAt         DateTime?            @map("disabled_at")
  purgedAt           DateTime?            @map("purged_at")
  // Suspension — set by admin suspend/unsuspend actions
  isSuspended        Boolean              @default(false) @map("is_suspended")
  suspendedAt        DateTime?            @map("suspended_at")
  suspendedReason    String?              @map("suspended_reason")
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")
  auctions           Auction[]
  activityEvents     BuyerActivityEvent[]
  user               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  deals              Deal[]
  deposits           Deposit[]
  notifications      Notification[]
  nudgeEvents        NudgeEvent[]
  preQualification   PreQualification?
  savedSearches      SavedSearch[]
  shortlists         Shortlist?
  vehicleRequests       VehicleRequest[]
  externalPreApprovals  ExternalPreApproval[]
  tradeInSubmissions    TradeInSubmission[]
  financingScenarios    FinancingScenario[]
  insuranceQuotes       InsuranceQuote[]
  insurancePolicies     InsurancePolicy[]
  refinanceApplications RefinanceApplication[]
  preferences           BuyerPreferences?
  complianceEvents      ComplianceEvent[]

  @@map("buyers")
}

model BuyerPreferences {
  id                   String   @id @default(uuid())
  buyerId              String   @unique @map("buyer_id")
  emailNotifications   Boolean  @default(true) @map("email_notifications")
  smsNotifications     Boolean  @default(false) @map("sms_notifications")
  marketingEmails      Boolean  @default(false) @map("marketing_emails")
  auctionAlerts        Boolean  @default(true) @map("auction_alerts")
  dealUpdates          Boolean  @default(true) @map("deal_updates")
  vehicleTypePreference String? @map("vehicle_type_preference")
  newOrUsedPreference   String? @map("new_or_used_preference")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")
  buyer                Buyer    @relation(fields: [buyerId], references: [id], onDelete: Cascade)

  @@map("buyer_preferences")
}

model Dealer {
  id                 String                    @id @default(uuid())
  userId             String                    @unique @map("user_id")
  dealershipName     String                    @map("dealership_name")
  phone              String?
  address            String?
  city               String?
  state              String?
  zip                String?
  status             DealerStatus              @default(PENDING)
  tier               String                    @default("STANDARD")
  currentAuctionLoad Int                       @default(0) @map("current_auction_load")
  scorecardTier      String?                   @map("scorecard_tier")
  createdAt          DateTime                  @default(now()) @map("created_at")
  updatedAt          DateTime                  @updatedAt @map("updated_at")
  scorecardSnapshots DealerScorecardSnapshot[]
  user               User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  inventory          InventoryItem[]
  notifications      Notification[]
  offers             Offer[]
  invitations        AuctionInvitation[]       @relation("DealerInvitations")
  feedConfig         DealerFeedConfig?         @relation("DealerFeedConfig")
  licenseNumber      String?                   @map("license_number")
  agreedToTermsAt    DateTime?                 @map("agreed_to_terms_at")
  onboardingStep     String                    @default("BUSINESS_INFO") @map("onboarding_step")

  // DocuSign marketplace agreement (sent at onboarding completion).
  // Webhook flips `marketplaceAgreementSignedAt` once the envelope completes.
  marketplaceAgreementEnvelopeId String?   @map("marketplace_agreement_envelope_id")
  marketplaceAgreementSentAt     DateTime? @map("marketplace_agreement_sent_at")
  marketplaceAgreementSignedAt   DateTime? @map("marketplace_agreement_signed_at")

  @@map("dealers")
}

model Affiliate {
  id                   String          @id @default(uuid())
  userId               String          @unique @map("user_id")
  referralCode         String          @unique @map("referral_code")
  status               AffiliateStatus @default(PENDING)
  parentId             String?         @map("parent_id")
  level                Int             @default(1)
  promotionMethod      String?         @map("promotion_method")
  website              String?
  ftcAcknowledgedAt    DateTime?       @map("ftc_acknowledged_at")
  weeklyDigestEnabled  Boolean         @default(true) @map("weekly_digest_enabled")
  lastDigestSentAt     DateTime?       @map("last_digest_sent_at")
  unsubscribeToken     String?         @unique @map("unsubscribe_token")
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")
  parent               Affiliate?      @relation("AffiliateTree", fields: [parentId], references: [id])
  children             Affiliate[]     @relation("AffiliateTree")
  user                 User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  commissions          Commission[]
  notifications        Notification[]
  payouts              AffiliatePayout[] @relation("AffiliatePayouts")
  payoutMethod         AffiliatePayoutMethod?
  documents            AffiliateDocument[]
  profile              AffiliateProfile?
  taxProfile           AffiliateTaxProfile?
  paymentProfile       AffiliatePaymentProfile?
  onboardingReview     AffiliateOnboardingReview?

  @@map("affiliates")
}

model Admin {
  id                      String    @id @default(uuid())
  userId                  String    @unique @map("user_id")
  role                    AdminRole
  passwordHash            String?   @map("password_hash")   // bcrypt hash of admin password
  totpSecret              String?   @map("totp_secret")
  totpEnabled             Boolean   @default(false) @map("totp_enabled")
  recoveryCodes           String[]  @map("recovery_codes")
  pendingRecoveryCodes    String[]  @map("pending_recovery_codes")
  mfaVerifiedAt           DateTime? @map("mfa_verified_at")
  lastRecoveryCodeUsedAt  DateTime? @map("last_recovery_code_used_at")
  failedMfaAttempts       Int       @default(0) @map("mfa_failed_attempts")
  mfaLockedUntil          DateTime? @map("mfa_locked_until")
  mfaResetAt              DateTime? @map("mfa_reset_at")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  mfaEmailTokens          AdminMfaEmailToken[]

  @@map("admins")
}

model AdminMfaEmailToken {
  id        String    @id @default(uuid())
  adminId   String    @map("admin_id")
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  admin     Admin     @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@map("admin_mfa_email_tokens")
}

model PreQualification {
  id                  String          @id @default(uuid())
  buyerId             String          @unique @map("buyer_id")
  decision            PreQualDecision
  tier                PreQualTier?
  expiresAt           DateTime        @map("expires_at")
  maxOtdAmountCents   Int             @map("max_otd_amount_cents")
  checkOfacAlert      Boolean         @default(false) @map("check_ofac_alert")
  rawResponse         String?         @map("raw_response")
  isExternal          Boolean         @default(false) @map("is_external")
  // Optional employment data — AutoLenis-internal only, never sent to MicroBilt.
  employmentStatus    String?         @map("employment_status")
  employerName        String?         @map("employer_name")
  monthlyIncomeCents  Int?            @map("monthly_income_cents")
  lengthOfEmployment  String?         @map("length_of_employment")
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")
  buyer               Buyer           @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  consents            PrequalConsent[]
  complianceEvents    ComplianceEvent[]

  @@map("pre_qualifications")
}

model PrequalConsent {
  id             String           @id @default(uuid())
  prequalId     String           @map("prequal_id")
  buyerId        String           @map("buyer_id")
  consentText    String           @map("consent_text")
  acceptedAt     DateTime         @default(now()) @map("accepted_at")
  ipAddress      String?          @map("ip_address")
  userAgent      String?          @map("user_agent")
  termsVersion   String?          @map("terms_version")
  prequal        PreQualification @relation(fields: [prequalId], references: [id], onDelete: Cascade)

  @@index([prequalId])
  @@index([buyerId])
  @@map("prequal_consents")
}

model ComplianceEvent {
  id                   String            @id @default(uuid())
  eventType            String            @map("event_type")
  buyerId              String            @map("buyer_id")
  prequalApplicationId String?           @map("prequal_application_id")
  metadata             Json?
  createdAt            DateTime          @default(now()) @map("created_at")
  buyer                Buyer             @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  prequalApplication   PreQualification? @relation(fields: [prequalApplicationId], references: [id], onDelete: SetNull)

  @@index([buyerId, createdAt])
  @@index([eventType])
  @@map("compliance_events")
}

model Shortlist {
  id        String          @id @default(uuid())
  buyerId   String          @unique @map("buyer_id")
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")
  items     ShortlistItem[]
  buyer     Buyer           @relation(fields: [buyerId], references: [id], onDelete: Cascade)

  @@map("shortlists")
}

model ShortlistItem {
  id              String    @id @default(uuid())
  shortlistId     String    @map("shortlist_id")
  inventoryItemId String    @map("inventory_item_id")
  addedAt         DateTime  @default(now()) @map("added_at")
  readinessState  String    @default("AUCTION_READY") @map("readiness_state")
  shortlist       Shortlist @relation(fields: [shortlistId], references: [id], onDelete: Cascade)

  @@unique([shortlistId, inventoryItemId])
  @@map("shortlist_items")
}

model Deposit {
  id                    String        @id @default(uuid())
  buyerId               String        @map("buyer_id")
  amountCents           Int           @map("amount_cents")
  status                DepositStatus @default(PENDING)
  stripePaymentIntentId String?       @unique @map("stripe_payment_intent_id")
  stripeSessionId       String?       @unique @map("stripe_session_id")
  refundedAt            DateTime?     @map("refunded_at")
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")
  auction               Auction?
  buyer                 Buyer         @relation(fields: [buyerId], references: [id])

  @@map("deposits")
}

model Auction {
  id                String              @id @default(uuid())
  buyerId           String              @map("buyer_id")
  depositId         String              @unique @map("deposit_id")
  status            AuctionStatus       @default(PENDING)
  startedAt         DateTime?           @map("started_at")
  endsAt            DateTime?           @map("ends_at")
  closedAt          DateTime?           @map("closed_at")
  extendedAt        DateTime?           @map("extended_at")
  extendedBy        String?             @map("extended_by")
  extendReason      String?             @map("extend_reason")
  originalAuctionId String?             @map("original_auction_id")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")
  invitations       AuctionInvitation[]
  buyer             Buyer               @relation(fields: [buyerId], references: [id])
  deposit           Deposit             @relation(fields: [depositId], references: [id])
  originalAuction   Auction?            @relation("AuctionRetry", fields: [originalAuctionId], references: [id])
  retryAuctions     Auction[]           @relation("AuctionRetry")
  offers            Offer[]

  @@map("auctions")
}

model AuctionInvitation {
  id              String    @id @default(uuid())
  auctionId       String    @map("auction_id")
  dealerId        String    @map("dealer_id")
  invitationScore Float?    @map("invitation_score")
  sentAt          DateTime  @default(now()) @map("sent_at")
  viewedAt        DateTime? @map("viewed_at")
  respondedAt     DateTime? @map("responded_at")
  auction         Auction   @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  dealer          Dealer    @relation("DealerInvitations", fields: [dealerId], references: [id])

  @@unique([auctionId, dealerId])
  @@map("auction_invitations")
}

model Offer {
  id                String      @id @default(uuid())
  auctionId         String      @map("auction_id")
  dealerId          String      @map("dealer_id")
  status            OfferStatus @default(DRAFT)
  otdPriceCents     Int         @map("otd_price_cents")
  vehiclePriceCents Int         @map("vehicle_price_cents")
  taxCents          Int         @default(0) @map("tax_cents")
  feesCents         Int         @default(0) @map("fees_cents")
  junkFeeItems      Json        @default("[]") @map("junk_fee_items")
  includesFinancing Boolean     @default(false) @map("includes_financing")
  aprRate           Float?      @map("apr_rate")
  termMonths        Int?        @map("term_months")
  bestPriceScore    Float?      @map("best_price_score")
  rankCash          Int?        @map("rank_cash")
  rankMonthly       Int?        @map("rank_monthly")
  rankBalanced      Int?        @map("rank_balanced")
  aprFlag           String?     @map("apr_flag")
  version           Int         @default(1)
  originalOfferId   String?     @unique @map("original_offer_id")
  submittedAt       DateTime?   @map("submitted_at")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")
  deal              Deal?
  auction           Auction     @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  dealer            Dealer      @relation(fields: [dealerId], references: [id])
  originalOffer     Offer?      @relation("OfferRevision", fields: [originalOfferId], references: [id])
  revisedOffer      Offer?      @relation("OfferRevision")

  @@map("offers")
}

model Deal {
  id                   String          @id @default(uuid())
  buyerId              String          @map("buyer_id")
  offerId              String          @unique @map("offer_id")
  status               DealStatus      @default(PENDING)
  financingPath        String?         @map("financing_path")
  insuranceStatus      InsuranceStatus @default(NOT_STARTED) @map("insurance_status")
  feePaidAt            DateTime?       @map("fee_paid_at")
  feeAmountCents       Int?            @map("fee_amount_cents")
  stripeFeePIId        String?         @map("stripe_fee_pi_id")
  feeRefundedAt        DateTime?       @map("fee_refunded_at")
  feeRefundedAmountCents Int?          @map("fee_refunded_amount_cents")
  contractShieldScore  Int?            @map("contract_shield_score")
  contractShieldStatus String?         @map("contract_shield_status")
  riskScore            Int?            @map("risk_score")
  riskTier             RiskTier?       @map("risk_tier")
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")
  contractScans        ContractScan[]
  buyer                Buyer           @relation(fields: [buyerId], references: [id])
  offer                Offer           @relation(fields: [offerId], references: [id])
  eSignEnvelope        ESignEnvelope?
  pickup               Pickup?
  financing            Financing?
  contractVersions     ContractVersion[]
  notes                DealNote[]

  @@map("deals")
}

model DealNote {
  id         String   @id @default(uuid())
  dealId     String   @map("deal_id")
  adminId    String   @map("admin_id")
  adminEmail String   @map("admin_email")
  content    String
  createdAt  DateTime @default(now()) @map("created_at")
  deal       Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId])
  @@map("deal_notes")
}

model ContractScan {
  id        String   @id @default(uuid())
  dealId    String   @map("deal_id")
  score     Int
  status    String
  fixList   Json     @default("[]") @map("fix_list")
  changeLog Json?    @map("change_log")
  version   Int      @default(1)
  scannedAt DateTime @default(now()) @map("scanned_at")
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@map("contract_scans")
}

model ContractScanRule {
  id          String   @id @default(uuid())
  name        String
  description String?
  ruleType    String   @map("rule_type")
  severity    String
  isActive    Boolean  @default(true) @map("is_active")
  config      Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("contract_scan_rules")
}

model ViolationPatternRecord {
  id        String   @id @default(uuid())
  dealerId  String   @map("dealer_id")
  ruleId    String   @map("rule_id")
  count     Int      @default(1)
  flagged   Boolean  @default(false)
  firstSeen DateTime @default(now()) @map("first_seen")
  lastSeen  DateTime @updatedAt @map("last_seen")

  @@unique([dealerId, ruleId])
  @@map("violation_pattern_records")
}

model ESignEnvelope {
  id                 String      @id @default(uuid())
  dealId             String      @unique @map("deal_id")
  docusignEnvelopeId String?     @unique @map("docusign_envelope_id")
  status             ESignStatus @default(PENDING)
  sentAt             DateTime?   @map("sent_at")
  completedAt        DateTime?   @map("completed_at")
  voidedAt           DateTime?   @map("voided_at")
  voidReason         String?     @map("void_reason")
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")
  deal               Deal        @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@map("e_sign_envelopes")
}

model Pickup {
  id          String       @id @default(uuid())
  dealId      String       @unique @map("deal_id")
  status      PickupStatus @default(NOT_SCHEDULED)
  scheduledAt DateTime?    @map("scheduled_at")
  completedAt DateTime?    @map("completed_at")
  location    String?
  qrCodeData  String?      @map("qr_code_data")
  qrCodeImage String?      @map("qr_code_image")
  qrExpiresAt DateTime?    @map("qr_expires_at")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  deal        Deal         @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@map("pickups")
}

model PaymentProviderEvent {
  id          String    @id @default(uuid())
  eventId     String    @unique @map("event_id")
  eventType   String    @map("event_type")
  payload     Json
  processed   Boolean   @default(false)
  processedAt DateTime? @map("processed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("payment_provider_events")
}

model Commission {
  id                String           @id @default(uuid())
  affiliateId       String           @map("affiliate_id")
  dealId            String           @map("deal_id")
  level             Int
  rate              Float
  amountCents       Int              @map("amount_cents")
  status            CommissionStatus @default(PENDING)
  qualifyingEventId String           @unique @map("qualifying_event_id")
  paidAt            DateTime?        @map("paid_at")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  affiliate         Affiliate        @relation(fields: [affiliateId], references: [id])

  @@map("commissions")
}

model Notification {
  id          String              @id @default(uuid())
  buyerId     String?             @map("buyer_id")
  dealerId    String?             @map("dealer_id")
  affiliateId String?             @map("affiliate_id")
  type        NotificationType
  channel     NotificationChannel @default(IN_APP)
  title       String
  body        String
  actionUrl   String?             @map("action_url")
  readAt      DateTime?           @map("read_at")
  metadata    Json?
  createdAt   DateTime            @default(now()) @map("created_at")
  affiliate   Affiliate?          @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  buyer       Buyer?              @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  dealer      Dealer?             @relation(fields: [dealerId], references: [id], onDelete: Cascade)

  @@index([buyerId, readAt])
  @@index([dealerId, readAt])
  @@index([affiliateId, readAt])
  @@map("notifications")
}

model NudgeEvent {
  id          String       @id @default(uuid())
  buyerId     String       @map("buyer_id")
  stage       String
  channel     NudgeChannel
  triggeredAt DateTime     @default(now()) @map("triggered_at")
  dismissedAt DateTime?    @map("dismissed_at")
  sentAt      DateTime?    @map("sent_at")
  buyer       Buyer        @relation(fields: [buyerId], references: [id], onDelete: Cascade)

  @@index([buyerId, stage])
  @@map("nudge_events")
}

model InventoryItem {
  id                  String        @id @default(uuid())
  dealerId            String?       @map("dealer_id")
  lane                InventoryLane @default(LANE_3)
  vin                 String?       @unique
  year                Int
  make                String
  model               String
  trim                String?
  mileage             Int?
  priceCents          Int           @map("price_cents")
  condition           String?       // "new" | "used"
  bodyType            String?       @map("body_type")
  exteriorColor       String?       @map("exterior_color")
  interiorColor       String?       @map("interior_color")
  engine              String?
  transmission        String?
  drivetrain          String?
  fuelType            String?       @map("fuel_type")
  city                String?
  state               String?
  zip                 String?
  description         String?
  features            String[]      @default([])
  priceHistory        Json          @default("[]") @map("price_history")
  latitude            Decimal?      @db.Decimal(10, 7)
  longitude           Decimal?      @db.Decimal(10, 7)
  externalListingUrl  String?       @map("external_listing_url")
  externalDealerName  String?       @map("external_dealer_name")
  externalDealerPhone String?       @map("external_dealer_phone")
  externalDealerCity  String?       @map("external_dealer_city")
  externalDealerState String?       @map("external_dealer_state")
  images              String[]
  isActive            Boolean       @default(true) @map("is_active")
  lastSeenAt          DateTime?     @map("last_seen_at")
  sourceAdapter       String?       @map("source_adapter")
  addedByAdminId      String?       @map("added_by_admin_id")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")
  dealer              Dealer?       @relation(fields: [dealerId], references: [id])

  @@index([lane, isActive])
  @@index([sourceAdapter])
  @@map("inventory_items")
}

model InventoryUploadBatch {
  id           String   @id @default(uuid())
  adminId      String   @map("admin_id")
  adminEmail   String   @map("admin_email")
  filename     String?
  totalRows    Int      @default(0) @map("total_rows")
  successCount Int      @default(0) @map("success_count")
  failureCount Int      @default(0) @map("failure_count")
  status       String   @default("COMPLETED")
  errors       Json     @default("[]")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([adminId])
  @@map("inventory_upload_batches")
}

model VehicleRequest {
  id              String                                 @id @default(uuid())
  buyerId         String                                 @map("buyer_id")
  status          VehicleRequestStatus                   @default(SUBMITTED)
  makePreference  String?                                @map("make_preference")
  modelPreference String?                                @map("model_preference")
  yearMin         Int?                                   @map("year_min")
  yearMax         Int?                                   @map("year_max")
  maxBudgetCents  Int?                                   @map("max_budget_cents")
  notes           String?
  assignedAdminId String?                                @map("assigned_admin_id")
  cancelledAt     DateTime?                              @map("cancelled_at")
  cancelReason    String?                                @map("cancel_reason")
  createdAt       DateTime                               @default(now()) @map("created_at")
  updatedAt       DateTime                               @updatedAt @map("updated_at")
  buyerUpdates    VehicleRequestBuyerUpdate[]
  checkpoints     VehicleRequestDueDiligenceCheckpoint[]
  events          VehicleRequestEvent[]
  offers          VehicleRequestOffer[]
  researchLogs    VehicleRequestResearchLog[]
  financing       VehicleRequestFinancing?
  buyer           Buyer                                  @relation(fields: [buyerId], references: [id])

  @@index([buyerId, status])
  @@map("vehicle_requests")
}

model VehicleRequestFinancing {
  id                          String    @id @default(cuid())
  vehicleRequestId            String    @unique @map("vehicle_request_id")
  vehicleRequest              VehicleRequest @relation(fields: [vehicleRequestId], references: [id], onDelete: Cascade)

  // Payment method (shown to dealers in anonymized form — category only, never amounts)
  paymentMethod               String?   @map("payment_method")
  // FINANCE_AUTOLENIS | FINANCE_OUTSIDE | CASH | LEASE | UNDECIDED

  // Pre-approval status
  preApprovalStatus           String?   @map("pre_approval_status")
  // APPROVED | WANTS_HELP | SELF_ARRANGE | CASH | LEASE

  // If already approved (preApprovalStatus === APPROVED) — NEVER shown to dealers
  lenderName                  String?   @map("lender_name")
  approvedAmountCents         Int?      @map("approved_amount_cents")
  quotedApr                   Decimal?  @db.Decimal(5,3) @map("quoted_apr")
  approvalExpiresAt           DateTime? @map("approval_expires_at")
  downPaymentCents            Int?      @map("down_payment_cents")
  monthlyPaymentTargetCents   Int?      @map("monthly_payment_target_cents")
  preApprovalLetterUrl        String?   @map("pre_approval_letter_url")

  // If wants help (preApprovalStatus === WANTS_HELP) — NEVER shown to dealers
  estimatedCreditRange        String?   @map("estimated_credit_range")
  // EXCELLENT | GOOD | FAIR | BUILDING | PREFER_NOT_TO_SAY
  estimatedAnnualIncomeCents  Int?      @map("estimated_annual_income_cents")

  // If cash (preApprovalStatus === CASH)
  proofOfFundsAvailable       Boolean?  @map("proof_of_funds_available")
  maxBudgetCents              Int?      @map("max_budget_cents")

  // If lease (preApprovalStatus === LEASE)
  leaseTermMonths             Int?      @map("lease_term_months")
  leaseMilesPerYear           Int?      @map("lease_miles_per_year")

  // Universal fields
  tradeIn                     Boolean?  @map("trade_in")
  purchaseTimeframe           String?   @map("purchase_timeframe")
  // ASAP | WITHIN_7_DAYS | WITHIN_30_DAYS | WITHIN_60_DAYS_PLUS

  // Admin routing — computed server-side only, never client-submitted
  leadQualityScore            Int?      @map("lead_quality_score")
  adminBadge                  String?   @map("admin_badge")
  // NEEDS_PREQUAL | OUTSIDE_APPROVAL | CASH_BUYER | LEASE_PROSPECT | FINANCING_OPPORTUNITY

  createdAt                   DateTime  @default(now()) @map("created_at")
  updatedAt                   DateTime  @updatedAt @map("updated_at")

  @@map("vehicle_request_financing")
}

