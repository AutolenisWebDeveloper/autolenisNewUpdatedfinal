// S5 — derive-by-snapshot funnel observability. On the daily analytics-snapshot
// cadence, each buyer-funnel stage is COUNTed from its authoritative domain
// table and persisted here as a named counter (one row per metric per run), so
// the funnel shape becomes a time series for drop-off alerting and the (deferred)
// funnel dashboard. `windowHours` is null for cumulative funnel-stage counts and
// set (e.g. 24) for windowed failure counters (requests_closed_no_match,
// auctions_closed_zero_offers). This is a derived snapshot, NOT an
// event-incremented counter table.
model FunnelStageSnapshot {
  id           String   @id @default(uuid())
  snapshotDate DateTime @default(now()) @map("snapshot_date")
  metric       String
  count        Int
  windowHours  Int?     @map("window_hours")

