  id              String   @id @default(cuid())
  postId          String   @map("post_id")
  post            SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  // Platform reach/engagement metrics are nullable so an *unavailable* metric
  // (deprecated Graph field, or an endpoint not in scope for our token) persists
  // as NULL — distinct from a confirmed zero. The @default(0) keeps writers that
  // omit a field on the old zero behavior; only an explicit `null` records
  // "unknown" so the optimization loop can exclude it.
  impressions     Int?     @default(0)
  reach           Int?     @default(0)
  views           Int?     @default(0)
  watchTimePct    Float?   @map("watch_time_pct")
  completionRate  Float?   @map("completion_rate")
