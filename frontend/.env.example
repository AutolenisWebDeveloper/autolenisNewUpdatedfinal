HIGGSFIELD_API_SECRET=
HIGGSFIELD_API_BASE_URL=
HIGGSFIELD_SUBMIT_ENDPOINT=
HIGGSFIELD_STATUS_ENDPOINT=
RUNWAY_API_KEY=               # optional (Runway ML image-to-video)
BUFFER_API_KEY=               # optional (Buffer social publishing)
BUFFER_ORGANIZATION_ID=
BUFFER_PROFILE_FACEBOOK=
BUFFER_PROFILE_INSTAGRAM=
BUFFER_PROFILE_TIKTOK=
