# ── Apollo dealer-contact reveal (Block B) — OFF by default ──────────────────
# The paid tier stays inert until the live smoke test sets the cap AND the flag is
# flipped. apolloEnabled() requires BOTH a key and APOLLO_REVEAL_ENABLED === "true".
APOLLO_API_KEY=
APOLLO_REVEAL_ENABLED=          # "true" to enable the paid reveal tier (default: off)
# APOLLO_BASE_URL=             # optional override (default https://api.apollo.io/api/v1)
