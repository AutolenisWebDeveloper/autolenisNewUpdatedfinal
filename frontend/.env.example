# AutoLenis — Environment variable template
# -----------------------------------------------------------------------------
# Copy to `.env.local` and fill in real values. `.env.local` is gitignored and
# MUST NEVER be committed. This file lists variable NAMES only — no secrets.
#
# Legend:  (required) app assumes it is set   ·   (optional) feature no-ops if unset
# Source of truth for types/notes: frontend/env.d.ts
# =============================================================================

# ─── Database (Prisma) ───────────────────────────────────────────────────────
# DATABASE_URL: pooled connection (PgBouncer / Supabase pooler) used at runtime.
# DIRECT_URL:   direct, non-pooled connection. REQUIRED by `prisma migrate` and
#               `prisma validate` (schema.prisma sets datasource.directUrl).
#               See "Database URLs" in README.md.
DATABASE_URL=
DIRECT_URL=

# ─── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# ─── Stripe (LIVE keys in production) ────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ─── DocuSign ────────────────────────────────────────────────────────────────

# ─── MicroBilt iPredict (prequalification) ───────────────────────────────────
MICROBILT_CLIENT_ID=
MICROBILT_CLIENT_SECRET=
# Report URL — the FULL url INCLUDING the /GetReport suffix. Used verbatim; a URL
# that does not end in /GetReport is refused (REPORT_URL_INVALID).
MICROBILT_BASE_URL=           # e.g. https://api.microbilt.com/iPredict/GetReport
MICROBILT_OAUTH_BASE_URL=     # e.g. https://api.microbilt.com/OAuth/Token
MICROBILT_SANDBOX=            # optional: "true" bypasses MicroBilt, returns mock APPROVED
MICROBILT_SANDBOX_URL=        # optional: sandbox report URL (also /GetReport-suffixed)
MICROBILT_OAUTH_SANDBOX_URL=  # optional: sandbox token URL
MICROBILT_PRODUCT=            # optional: X-Product header, defaults to "IPredict Advantage"
MICROBILT_CAID=               # optional: X-CAID header
# Legacy fallbacks, read only when the *_BASE_URL names above are unset.
IPREDICT_GET_REPORT_URL=      # optional legacy fallback for MICROBILT_BASE_URL
MICROBILT_OAUTH_TOKEN_URL=    # optional legacy fallback for MICROBILT_OAUTH_BASE_URL
# MsgRqHdr identity + product routing — REQUIRED for a real (non-sandbox) pull.
# Obtain all four from MicroBilt; the adapter refuses to call GetReport without
# them rather than spending an inquiry on a request MicroBilt cannot route.
MICROBILT_MEMBER_ID=          # MsgRqHdr.MemberId
MICROBILT_MEMBER_PASSWORD=    # MsgRqHdr.MemberPwd (CREDENTIAL)
MICROBILT_USERNAME=           # MsgRqHdr.UserName
MICROBILT_PRODUCT_ID=         # MsgRqHdr.ProductID (selects IPredict Advantage)
MICROBILT_WEBHOOK_SECRET=     # optional: shared secret for the MicroBilt webhook

# ─── Security secrets ────────────────────────────────────────────────────────
JWT_SECRET=
ADMIN_JWT_SECRET=             # optional: isolates admin sessions (falls back to JWT_SECRET)
DEALER_JWT_SECRET=            # optional: isolates dealer sessions (falls back to JWT_SECRET)
CSRF_SECRET=
EMAIL_UNSUBSCRIBE_SECRET=
PREQUAL_ENCRYPTION_KEY=       # REQUIRED: 64-char hex (32-byte AES-256-GCM key). No default.
MFA_ENCRYPTION_KEY=           # optional: 64-char hex, dedicated TOTP-secret key
CRON_SECRET=

# ─── Email (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=
FROM_NAME=
RESEND_WEBHOOK_SECRET=        # optional: Svix signing secret for delivery/bounce events
# The three vars below plus RESEND_API_KEY are REQUIRED_EMAIL_ENV_VARS: sendDealerEmail
# refuses to dispatch any dealer outreach while one is unset, and returns before it can
# write a DealerOutreachLog row — so leaving one blank disables outreach silently.
DEALER_OUTREACH_FROM_EMAIL=   # REQUIRED for dealer outreach: envelope From
DEALER_OUTREACH_REPLY_TO=     # REQUIRED for dealer outreach: monitored Reply-To
AUTOLENIS_PHYSICAL_ADDRESS=   # REQUIRED for dealer outreach: CAN-SPAM postal address
ADMIN_NOTIFICATION_EMAIL=     # optional: ops inbox for admin alerts
DEV_EMAIL_TO=                 # optional: dev-only; MUST NOT be set in production

# ─── AI / LLM ────────────────────────────────────────────────────────────────
GROQ_API_KEY=                 # primary LLM provider
GEMINI_API_KEY=               # optional: Gemini 2.5 Flash (grounded search / enrichment)
ANTHROPIC_API_KEY=            # optional
OPENAI_API_KEY=               # optional: Whisper STT for the voice receptionist
AI_KILL_SWITCH=               # optional: "true" disables all AI

# ─── Background jobs (Inngest + QStash) ──────────────────────────────────────
INNGEST_SIGNING_KEY=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# ─── CRM dispatch auth (Make.com / code callers) ─────────────────────────────
CRM_DISPATCH_SECRET=
CRM_DISPATCH_KEY=             # optional: static bearer for no-code callers (>=32 random bytes)
CRM_INAPP_ENGINE_ENABLED=     # optional

# ─── Content Autopilot (scheduled buying-guide generation) ───────────────────
# The ONLY switch for the /api/cron/content-generation-seed cron, which enqueues
# up to 25 buying-guide articles per day from CONTENT_KEYWORDS. Downstream, the
# content-generation-drain cron generates each one and — because the seeder
# enqueues reviewOnly:false — anything that clears the compliance validator, the
# quality rubric AND post-generation validation is PUBLISHED straight to the
# public site at /buying-guide/[slug], with no human review.
#
# DEFAULT OFF. Unset, empty, "1" and "TRUE" all read as disabled; only the exact
# string "true" enables it. Read at call time, so flipping it in the Vercel
# project takes effect on the next run with NO redeploy — that is also how the
# owner turns it off again.
#
# COST: each enqueued item is exactly one Groq generation, so 25/day is 25
# generations/day. Raising the cap (CONTENT_SEED_MAX_PER_RUN in
# lib/services/content/content-generation.service.ts) raises spend linearly.
CONTENT_AUTOPILOT_ENABLED=    # optional: "true" enables scheduled auto-generate + auto-publish

# ─── E-sign executed-artifact schema gate ────────────────────────────────────
# Migrations 20261014_esign_envelope_history and
# 20261015_esign_consent_and_executed_artifact are AUTHORED BUT NOT APPLIED to
# production (owner-gated pending attorney/compliance review of the consent
# policy). The Prisma schema already declares the columns and the history table
# they add, so the app must not ask the database for them until they exist.
#
# OFF (default, and correct for production today):
#   * every e-sign READ is projected to the pre-migration columns, so buyer,
#     dealer and admin surfaces keep working;
#   * the executed-contract artifact / consent-snapshot / attempt-history
#     features report themselves unavailable;
#   * the esign-artifact-reconcile cron records a truthful skip; AND
#   * ELECTRONIC SIGNING FAILS CLOSED — preparing an envelope, recording a
#     signature, and the admin resend all return 503 (ESIGN_UNAVAILABLE),
#     because a signature whose frozen consent snapshot cannot be persisted
#     would be a false success. Buyers cannot sign while this is off.
#
# Set to "true" ONLY after BOTH migrations have actually been applied to the
# target database. Turning it on against an unmigrated database re-introduces
# the 42703 / 42P01 failures it exists to prevent.
ESIGN_EXECUTED_ARTIFACT_ENABLED=  # optional: "true" only when 20261014+20261015 are applied

# ---------------------------------------------------------------------------
# Deposit settlement reconciler (P0 #2) — OFF BY DEFAULT.
#
# Converts a PENDING Deposit whose Stripe PaymentIntent already succeeded into
# PAID, which then lets the existing activation reconciler create and launch the
# buyer's auction. It exists because the Stripe webhook — the only other writer
# of that transition — has never delivered in production, so paying buyers
# stayed PENDING forever and got no auction.
#
# This WRITES MONEY STATE. It is a backstop for a broken webhook, not a
# replacement for one: every settlement it makes raises a SYSTEM_ALERT on
# /admin/operations, because a deposit settled by polling means the webhook did
# not arrive. It never writes a PaymentProviderEvent (nothing was received).
#
# Before setting this to "true": fix/verify the Stripe webhook endpoint first,
# and confirm DEPOSIT_SETTLEMENT_EXCLUDED_DEPOSIT_IDS below still reflects any
# deposit that must not be touched.
DEPOSIT_SETTLEMENT_RECONCILE_ENABLED=   # optional: "true" enables settlement sweeps

# Comma-separated Deposit ids the settlement reconciler must never act on.
# LEAVING THIS UNSET IS SAFE: the code's built-in default already excludes the
# deposit under owner investigation. Setting it REPLACES that default, so if you
# set it, include any id that must stay excluded.
DEPOSIT_SETTLEMENT_EXCLUDED_DEPOSIT_IDS=  # optional: overrides the built-in exclusion list

GHL_WEBHOOK_URL=              # optional: GoHighLevel inbound tag sync
GHL_PARTIAL_LEAD_WEBHOOK_URL= # optional
NEXT_PUBLIC_GHL_THANKYOU_WEBHOOK_URL= # optional
MAKE_WEBHOOK_URL=             # optional
MAKE_WEBHOOK_SECRET=          # optional

# ─── Twilio (SMS + voice receptionist) ───────────────────────────────────────
TWILIO_ACCOUNT_SID=           # optional
TWILIO_AUTH_TOKEN=            # optional
TWILIO_FROM_NUMBER=           # optional
TWILIO_PHONE_NUMBER=          # optional
TWILIO_LOCAL_NUMBER=          # optional
TWILIO_TOLLFREE_NUMBER=       # optional
TWILIO_TRANSFER_NUMBER=       # optional
TWILIO_WEBHOOK_URL=           # optional: exact public URL for inbound SMS signature base
TWILIO_VERIFY_ALT_HOST=       # optional
FOUNDER_PHONE_NUMBER=         # optional: hot-lead live-transfer target
ENABLE_LIVE_CALL_TRANSFER=    # optional: "true" enables live transfers

# ─── Voice (ElevenLabs / Whisper) ────────────────────────────────────────────
ELEVENLABS_API_KEY=           # optional
ELEVENLABS_VOICE_ID=          # optional
VOICE_USE_WHISPER=            # optional: "false" reverts to Twilio STT

# ─── Search intelligence / inventory data ────────────────────────────────────
GOOGLE_SEARCH_CONSOLE_KEY=    # optional: base64 GSC service-account JSON
GSC_SITE_URL=                 # optional
MARKETCHECK_API_KEY=          # optional: inventory data provider
RAPIDAPI_KEY=                 # optional

# ─── Dealer prospecting / contact enrichment (Apollo.io) ─────────────────────
# APOLLO_API_KEY: Apollo.io REST API key (People Search / Organization Lookup /
#   People Enrichment). Read SERVER-SIDE ONLY — never exposed to the client. The
#   Apollo enrichment path no-ops when unset. Put the real key in `.env.local`
#   locally and in the Vercel project env for deploys — never commit it here.
#   Dealer enrichment/outreach stays OFF until ENABLE_APOLLO_ENRICHMENT="true".
APOLLO_API_KEY=               # optional: Apollo.io REST API key (server-side only)
APOLLO_API_BASE_URL=          # optional: defaults to https://api.apollo.io/api/v1
ENABLE_APOLLO_ENRICHMENT=     # optional: "true" enables Apollo enrichment (default off)

# ─── Platform / misc ─────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=
MAINTENANCE_MODE=
CURRENT_TERMS_VERSION=
OPENROAD_PARTNER_ID=
REFERRAL_IP_SALT=             # optional: salt for hashing affiliate-click IPs
LOG_LEVEL=                    # optional: logger threshold
REDIS_URL=                    # optional
SENTRY_DSN=                   # optional
APP_SECRET=                   # optional
NEXTAUTH_SECRET=              # optional

# ─── Public contact / support surface ────────────────────────────────────────
NEXT_PUBLIC_SUPPORT_EMAIL=    # optional
SUPPORT_EMAIL=                # optional
SUPPORT_PHONE=                # optional
NEXT_PUBLIC_COMPANY_ADDRESS=  # optional
NEXT_PUBLIC_CLARITY_ID=       # optional: Microsoft Clarity analytics
NEXT_PUBLIC_GOOGLE_OAUTH_ENABLED= # optional
ADMIN_EMAIL=                  # optional
FOUNDER_EMAIL=                # optional

# ─── Announcement banner / explainer video (optional UI) ─────────────────────
NEXT_PUBLIC_ANNOUNCEMENT_MESSAGE=
NEXT_PUBLIC_ANNOUNCEMENT_LINK_TEXT=
NEXT_PUBLIC_ANNOUNCEMENT_LINK_HREF=
