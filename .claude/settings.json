{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": [
    "buffer",
    "filesystem",
    "sequential-thinking",
    "memory",
    "playwright",
    "context7",
    "graphify"
  ],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/session-start.sh\"",
            "timeout": 600,
            "statusMessage": "Installing frontend dependencies (async)"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/skills/impeccable/scripts/hook.mjs\"",
            "timeout": 5,
            "statusMessage": "Checking UI changes"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/verification/track.mjs\"",
            "timeout": 5,
            "statusMessage": "Tracking verification evidence"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/verification/gate.mjs\"",
            "timeout": 10,
            "statusMessage": "Checking verification loop"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-destructive.sh\"",
            "timeout": 10,
            "statusMessage": "Checking for destructive commands"
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-protected-paths.sh\"",
            "timeout": 10,
            "statusMessage": "Checking protected paths"
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "superpowers-marketplace": {
      "source": {
        "source": "directory",
        "path": ".claude/plugins/superpowers-marketplace"
      }
    }
  },
  "enabledPlugins": {
    "superpowers@superpowers-marketplace": true
  },
  "permissions": {
    "deny": [
      "Bash(git merge:*)",
      "Bash(git mergetool:*)",
      "Bash(git reset --hard:*)",
      "Bash(git push --force:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push -f:*)",
      "Bash(git push *--force*)",
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(rm -Rf:*)",
      "Bash(rm -fR:*)",
      "Bash(supabase db push:*)",
      "Bash(supabase db reset:*)",
      "Bash(vercel deploy:*)",
      "Bash(vercel --prod:*)",
      "Bash(vercel *--prod*)",
      "Bash(prisma migrate deploy:*)",
      "Bash(prisma migrate reset:*)",
      "Bash(prisma migrate dev:*)",
      "Bash(prisma db push:*)",
      "Bash(prisma db execute:*)",
      "Bash(dropdb:*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Edit(**/.env)",
      "Edit(**/.env.*)"
    ],
    "ask": [
      "Bash(pnpm build:*)",
      "Bash(pnpm run build:*)",
      "Bash(npm run build:*)",
      "Bash(yarn build:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm run lint:*)",
      "Bash(npm run lint:*)",
      "Bash(yarn lint:*)",
      "Bash(vercel:*)",
      "Bash(supabase:*)",
      "Bash(psql:*)",
      "Edit(**/prisma/migrations/**)",
      "Edit(**/supabase/migrations/**)",
      "Edit(frontend/migrations/**)"
    ],
    "allow": [
      "Bash(pnpm typecheck*)",
      "Bash(pnpm test*)",
      "Bash(pnpm install*)",
      "Bash(pnpm exec prisma generate*)",
      "Bash(pnpm exec prisma validate*)",
      "Bash(npx prisma generate*)",
      "Bash(node .claude/validate-skills.mjs*)"
    ]
  }
}
